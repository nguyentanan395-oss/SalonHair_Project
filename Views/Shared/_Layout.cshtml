<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SalonHair</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SalonHair.styles.css" asp-append-version="true" />
    <style>
        .dropdown-item {
            transition: all 0.2s ease;
            border-radius: 4px;
            margin: 2px 8px;
            width: auto;
        }
        .dropdown-item:hover {
            background-color: transparent !important;
            color: #ffc107 !important; /* Màu vàng Gold */
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.3);
        }
    </style>
</head>
<body class="bg-salon">
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-scissors"></i>
                    SalonHair
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door"></i>
                                Trang chủ
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Products" asp-action="Index">
                                <i class="bi bi-shop"></i>
                                Sản phẩm
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Bookings" asp-action="DatLich">
                                <i class="bi bi-calendar-plus"></i>
                                Đặt lịch
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="AiSuggest" asp-action="Index">
                                <i class="bi bi-stars"></i>
                                AI Tư vấn
                            </a>
                        </li>
                        @if (!User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="Bookings" asp-action="History">
                                    <i class="bi bi-clock-history"></i>
                                    Lịch sử
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-area="" asp-controller="Reviews" asp-action="Create">
                                    <i class="bi bi-chat-square-heart"></i>
                                    Đánh giá dịch vụ
                                </a>
                            </li>
                        }
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-warning fw-bold" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-shield-lock me-1"></i> Quản trị
                                </a>
                                <ul class="dropdown-menu bg-dark border-warning shadow" aria-labelledby="adminDropdown">
                                    <li><a class="dropdown-item text-warning fw-bold" asp-controller="Bookings" asp-action="Dashboard"><i class="bi bi-graph-up-arrow me-2"></i>Thống kê hệ thống</a></li>
                                    <li><hr class="dropdown-divider border-secondary"></li>
                                    <li><a class="dropdown-item text-white" asp-controller="Users" asp-action="Index">Quản lý tài khoản</a></li>
                                    <li><a class="dropdown-item text-white" asp-controller="Customers" asp-action="Index">Quản lý khách hàng</a></li>
                                    <li><a class="dropdown-item text-white" asp-controller="Bookings" asp-action="Index">Quản lý Lịch hẹn</a></li>
                                    <li><a class="dropdown-item text-white" asp-controller="Products" asp-action="Manage">Quản lý Sản phẩm</a></li>
                                    <li><a class="dropdown-item text-white" asp-controller="Orders" asp-action="Index">Quản lý Đơn hàng</a></li>
                                    <li><a class="dropdown-item text-white" asp-controller="Reviews" asp-action="Index">Quản lý Đánh giá</a></li>
                                    <li><a class="dropdown-item text-white" asp-controller="Payment" asp-action="Index">Quản lý thanh toán</a></li>
                                </ul>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-white fw-bold" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle me-1"></i> @User.Identity.Name
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end bg-dark border-warning shadow" aria-labelledby="userDropdown">
                                    <li><a class="dropdown-item text-white" asp-controller="Account" asp-action="Profile"><i class="bi bi-person me-2"></i>Hồ sơ</a></li>
                                    <li><hr class="dropdown-divider border-secondary"></li>
                                    <li><a class="dropdown-item text-danger fw-bold" asp-controller="Account" asp-action="Logout"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</a></li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white fw-bold" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>