@model SalonHair.Models.Booking

@{
    ViewData["Title"] = "Chỉnh sửa lịch hẹn";
}

<div class="modal-header">
    <h5 class="modal-title gold-text fw-bold"><i class="bi bi-pencil-square me-2"></i>CHỈNH SỬA LỊCH HẸN</h5>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<div class="modal-body p-4">
    <form asp-action="Edit" id="editBookingForm">
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
        <input type="hidden" asp-for="Id" />
        
        <div class="mb-3">
            <label class="form-label fw-bold gold-text">Họ và Tên</label>
            <input asp-for="CustomerName" class="form-control" required />
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold gold-text">Số điện thoại</label>
            <input asp-for="Phone" class="form-control" required />
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold gold-text">Dịch vụ</label>
            <select asp-for="ServiceId" class="form-select" asp-items="ViewBag.ServiceId"></select>
        </div>

        <div class="mb-4">
            <label class="form-label fw-bold gold-text">Ngày giờ hẹn</label>
            <input asp-for="BookingDate" type="datetime-local" class="form-control" required />
        </div>

        <div class="d-grid gap-2">
            <button type="submit" class="btn btn-warning fw-bold">LƯU THAY ĐỔI</button>
            <a asp-action="Index" class="btn btn-outline-light">HỦY</a>
        </div>
    </form>
</div>