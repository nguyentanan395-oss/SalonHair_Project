@{
    ViewData["Title"] = "Thống kê hệ thống";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-warning fw-bold mb-0 text-uppercase"><i class="bi bi-speedometer2 me-2"></i> Dashboard Thống Kê</h2>
        <div class="text-secondary small">Cập nhật lúc: @DateTime.Now.ToString("HH:mm dd/MM/yyyy")</div>
    </div>

    <!-- Hàng 1: Các chỉ số quan trọng -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card bg-dark border-gold-card h-100 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h6 class="text-uppercase text-secondary small fw-bold">Tổng Lịch Hẹn</h6>
                            <h2 class="text-white fw-bold mb-0">@ViewBag.TotalBookings</h2>
                        </div>
                        <div class="fs-1 text-warning opacity-50"><i class="bi bi-calendar-check"></i></div>
                    </div>
                    <div class="mt-3 text-info small">
                        <i class="bi bi-clock-history"></i> Hôm nay: @ViewBag.TodayBookings
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-dark border-gold-card h-100 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h6 class="text-uppercase text-secondary small fw-bold">Tổng Doanh Thu</h6>
                            <h2 class="text-success fw-bold mb-0">@ViewBag.TotalRevenue.ToString("N0")đ</h2>
                        </div>
                        <div class="fs-1 text-success opacity-50"><i class="bi bi-currency-dollar"></i></div>
                    </div>
                    <div class="mt-3 text-secondary small">
                        Từ @ViewBag.TotalOrders đơn hàng shop
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-dark border-gold-card h-100 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h6 class="text-uppercase text-secondary small fw-bold">Thành Viên</h6>
                            <h2 class="text-white fw-bold mb-0">@ViewBag.TotalCustomers</h2>
                        </div>
                        <div class="fs-1 text-info opacity-50"><i class="bi bi-people"></i></div>
                    </div>
                    <div class="mt-3 text-secondary small">
                        Khách hàng đã đăng ký
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-dark border-gold-card h-100 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h6 class="text-uppercase text-secondary small fw-bold">Mức độ hài lòng</h6>
                            <h2 class="text-warning fw-bold mb-0">@ViewBag.AvgRating.ToString("F1") <i class="bi bi-star-fill small"></i></h2>
                        </div>
                        <div class="fs-1 text-warning opacity-50"><i class="bi bi-chat-heart"></i></div>
                    </div>
                    <div class="mt-3 text-secondary small">
                        Dựa trên @ViewBag.TotalReviews đánh giá
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Hàng 2: Quản lý tài nguyên -->
    <div class="row g-4">
        <div class="col-md-6">
            <div class="card bg-dark border-gold-card shadow">
                <div class="card-header bg-transparent border-bottom border-secondary">
                    <h5 class="text-warning mb-0"><i class="bi bi-box-seam me-2"></i>Quản lý tài nguyên hệ thống</h5>
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush bg-transparent">
                        <li class="list-group-item bg-transparent text-light border-secondary d-flex justify-content-between px-0">
                            <span>Số lượng sản phẩm đang bán</span>
                            <span class="badge bg-warning text-dark">@ViewBag.TotalProducts</span>
                        </li>
                        <li class="list-group-item bg-transparent text-light border-secondary d-flex justify-content-between px-0">
                            <span>Tổng số dịch vụ salon</span>
                            <span class="badge bg-warning text-dark">@ViewBag.TotalServices</span>
                        </li>
                    </ul>
                    <div class="mt-4 d-grid gap-2">
                        <a href="/Bookings/Index" class="btn btn-warning fw-bold">XỬ LÝ LỊCH HẸN NGAY</a>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card bg-dark border-gold-card shadow h-100">
                <div class="card-body d-flex flex-column justify-content-center text-center">
                    <i class="bi bi-shield-lock text-warning display-4 mb-3"></i>
                    <h4 class="text-white fw-bold">Khu vực quản trị bảo mật</h4>
                    <p class="text-secondary px-4">Dữ liệu trên được tổng hợp thời gian thực từ cơ sở dữ liệu. Vui lòng kiểm tra kỹ trước khi xuất báo cáo doanh thu hàng tháng.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .border-gold-card { border: 1px solid rgba(212, 175, 55, 0.3) !important; }
    .list-group-item { transition: 0.2s; border-bottom: 1px solid rgba(255,255,255,0.05) !important; }
    .list-group-item:hover { background: rgba(212, 175, 55, 0.1) !important; }
</style>