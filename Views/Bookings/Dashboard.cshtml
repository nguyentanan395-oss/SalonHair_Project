@{
ViewData["Title"] = "Thống kê hệ thống";


var currentTime = DateTime.Now.ToString("HH:mm dd/MM/yyyy");


}

<div class="dashboard-page">
    <div class="dashboard-card">


    <div class="page-header">
        <div>
            <h2>
                <i class="bi bi-speedometer2 me-2"></i>
                Dashboard thống kê
            </h2>
            <p>Tổng quan hoạt động salon, lịch hẹn, doanh thu, khách hàng và đánh giá</p>
        </div>

        <div class="update-time">
            <i class="bi bi-clock-history me-1"></i>
            Cập nhật: @currentTime
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-icon">
                    <i class="bi bi-calendar-check-fill"></i>
                </div>

                <div>
                    <span>Tổng lịch hẹn</span>
                    <h3>@ViewBag.TotalBookings</h3>
                    <small>
                        <i class="bi bi-clock me-1"></i>
                        Hôm nay: @ViewBag.TodayBookings
                    </small>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="stat-card revenue">
                <div class="stat-icon">
                    <i class="bi bi-cash-stack"></i>
                </div>

                <div>
                    <span>Tổng doanh thu</span>
                    <h3>@ViewBag.TotalRevenue.ToString("N0")đ</h3>
                    <small>Từ @ViewBag.TotalOrders đơn hàng shop</small>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="stat-card customer">
                <div class="stat-icon">
                    <i class="bi bi-people-fill"></i>
                </div>

                <div>
                    <span>Thành viên</span>
                    <h3>@ViewBag.TotalCustomers</h3>
                    <small>Khách hàng đã đăng ký</small>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="stat-card rating">
                <div class="stat-icon">
                    <i class="bi bi-star-fill"></i>
                </div>

                <div>
                    <span>Mức độ hài lòng</span>
                    <h3>@ViewBag.AvgRating.ToString("F1")/5</h3>
                    <small>Dựa trên @ViewBag.TotalReviews đánh giá</small>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-7">
            <div class="panel-card">
                <div class="panel-header">
                    <h5>
                        <i class="bi bi-box-seam-fill me-2"></i>
                        Tài nguyên hệ thống
                    </h5>
                </div>

                <div class="resource-list">
                    <a href="/Products/Manage" class="resource-item">
                        <div class="resource-left">
                            <div class="resource-icon">
                                <i class="bi bi-bag-check-fill"></i>
                            </div>

                            <div>
                                <strong>Sản phẩm đang bán</strong>
                                <span>Quản lý kho sản phẩm chăm sóc tóc</span>
                            </div>
                        </div>

                        <div class="resource-value">
                            @ViewBag.TotalProducts
                        </div>
                    </a>

                    <a href="/Services/Index" class="resource-item">
                        <div class="resource-left">
                            <div class="resource-icon">
                                <i class="bi bi-scissors"></i>
                            </div>

                            <div>
                                <strong>Dịch vụ salon</strong>
                                <span>Cắt, uốn, nhuộm, gội và combo</span>
                            </div>
                        </div>

                        <div class="resource-value">
                            @ViewBag.TotalServices
                        </div>
                    </a>
                </div>

                <div class="action-area">
                    <a href="/Bookings/Index" class="btn-main-action">
                        <i class="bi bi-calendar-check-fill me-2"></i>
                        Xử lý lịch hẹn
                    </a>

                    <a href="/Products/Manage" class="btn-outline-action">
                        <i class="bi bi-box-seam me-2"></i>
                        Quản lý kho
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-5">
            <div class="security-card">
                <div class="security-icon">
                    <i class="bi bi-shield-lock-fill"></i>
                </div>

                <h4>Khu vực quản trị bảo mật</h4>

                <p>
                    Dữ liệu được tổng hợp trực tiếp từ cơ sở dữ liệu hệ thống.
                    Vui lòng kiểm tra kỹ thông tin trước khi xuất báo cáo doanh thu,
                    lịch hẹn hoặc thống kê khách hàng.
                </p>

                <div class="security-note">
                    <i class="bi bi-database-check me-2"></i>
                    Dữ liệu đang được đồng bộ theo thời gian thực
                </div>
            </div>
        </div>
    </div>

</div

</div>

<style>
    body {
        background: #050505 !important;
    }

    .dashboard-page {
        min-height: calc(100vh - 80px);
        padding: 40px 15px;
        background:
            radial-gradient(circle at top left, rgba(212,175,55,0.12), transparent 35%),
            linear-gradient(135deg, #050505, #111);
    }

    .dashboard-card {
        max-width: 1300px;
        margin: auto;
        padding: 30px;
        border-radius: 30px;
        background: linear-gradient(145deg, #151515, #222);
        border: 1px solid rgba(212,175,55,0.42);
        box-shadow: 0 30px 70px rgba(0,0,0,.72);
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 28px;
        padding-bottom: 22px;
        border-bottom: 1px solid rgba(212,175,55,.22);
    }

    .page-header h2 {
        color: #d4af37;
        font-weight: 900;
        text-transform: uppercase;
        margin: 0;
    }

    .page-header p {
        color: #bfbfbf;
        margin: 6px 0 0;
    }

    .update-time {
        padding: 10px 16px;
        border-radius: 30px;
        color: #d4af37;
        background: rgba(212,175,55,.08);
        border: 1px solid rgba(212,175,55,.25);
        font-size: 13px;
        font-weight: 700;
        white-space: nowrap;
    }

    .stat-card {
        height: 150px;
        padding: 22px;
        border-radius: 24px;
        background: rgba(255,255,255,.035);
        border: 1px solid rgba(212,175,55,.22);
        color: #fff;
        position: relative;
        overflow: hidden;
        display: flex;
        gap: 16px;
        align-items: center;
    }

    .stat-card::after {
        content: "";
        position: absolute;
        right: -35px;
        bottom: -35px;
        width: 110px;
        height: 110px;
        border-radius: 50%;
        border: 1px solid rgba(212,175,55,.22);
    }

    .stat-icon {
        width: 58px;
        height: 58px;
        border-radius: 18px;
        background: rgba(212,175,55,.12);
        border: 1px solid rgba(212,175,55,.28);
        color: #d4af37;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        flex-shrink: 0;
    }

    .stat-card span {
        color: #bfbfbf;
        font-size: 13px;
        text-transform: uppercase;
        font-weight: 800;
    }

    .stat-card h3 {
        margin: 5px 0;
        font-size: 28px;
        font-weight: 900;
        color: #fff;
    }

    .stat-card small {
        color: #999;
        font-weight: 600;
    }

    .stat-card.revenue h3,
    .stat-card.revenue .stat-icon {
        color: #75d69c;
    }

    .stat-card.customer .stat-icon {
        color: #0dcaf0;
    }

    .stat-card.rating .stat-icon,
    .stat-card.rating h3 {
        color: #d4af37;
    }

    .panel-card,
    .security-card {
        height: 100%;
        padding: 26px;
        border-radius: 26px;
        background: rgba(255,255,255,.035);
        border: 1px solid rgba(255,255,255,.08);
        color: #fff;
    }

    .panel-header {
        margin-bottom: 20px;
        padding-bottom: 16px;
        border-bottom: 1px solid rgba(212,175,55,.22);
    }

    .panel-header h5 {
        margin: 0;
        color: #d4af37;
        font-weight: 900;
    }

    .resource-list {
        display: grid;
        gap: 14px;
    }

    .resource-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 18px;
        padding: 18px;
        border-radius: 18px;
        background: rgba(0,0,0,.28);
        border: 1px solid rgba(255,255,255,.07);
        color: #fff;
        text-decoration: none;
        transition: .25s;
    }

    .resource-item:hover {
        transform: translateY(-2px);
        background: rgba(212,175,55,.08);
        color: #fff;
        border-color: rgba(212,175,55,.28);
    }

    .resource-left {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .resource-icon {
        width: 48px;
        height: 48px;
        border-radius: 16px;
        background: rgba(212,175,55,.12);
        border: 1px solid rgba(212,175,55,.28);
        color: #d4af37;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
    }

    .resource-left strong {
        display: block;
        color: #fff;
        font-weight: 900;
    }

    .resource-left span {
        color: #999;
        font-size: 13px;
    }

    .resource-value {
        min-width: 48px;
        height: 38px;
        border-radius: 30px;
        background: linear-gradient(135deg, #d4af37, #f5d76e);
        color: #111;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 900;
        padding: 0 14px;
    }

    .action-area {
        display: flex;
        gap: 12px;
        margin-top: 24px;
    }

    .btn-main-action,
    .btn-outline-action {
        flex: 1;
        padding: 13px;
        border-radius: 30px;
        text-align: center;
        text-decoration: none;
        font-weight: 900;
        text-transform: uppercase;
        transition: .25s;
    }

    .btn-main-action {
        background: linear-gradient(135deg, #d4af37, #f5d76e);
        color: #111;
    }

    .btn-outline-action {
        background: transparent;
        color: #d4af37;
        border: 1px solid rgba(212,175,55,.55);
    }

    .btn-main-action:hover,
    .btn-outline-action:hover {
        transform: translateY(-2px);
        color: #111;
        box-shadow: 0 12px 25px rgba(212,175,55,.22);
    }

    .btn-outline-action:hover {
        color: #d4af37;
        background: rgba(212,175,55,.08);
    }

    .security-card {
        text-align: center;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .security-icon {
        width: 86px;
        height: 86px;
        margin: 0 auto 18px;
        border-radius: 50%;
        background: rgba(212,175,55,.12);
        border: 1px solid rgba(212,175,55,.35);
        color: #d4af37;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 42px;
        box-shadow: 0 0 25px rgba(212,175,55,.18);
    }

    .security-card h4 {
        color: #fff;
        font-weight: 900;
        margin-bottom: 12px;
    }

    .security-card p {
        color: #bfbfbf;
        line-height: 1.7;
        margin-bottom: 22px;
    }

    .security-note {
        padding: 13px 15px;
        border-radius: 18px;
        color: #d4af37;
        background: rgba(212,175,55,.08);
        border: 1px solid rgba(212,175,55,.25);
        font-size: 14px;
        font-weight: 700;
    }

    @@media (max-width: 768px) {
        .page-header,
        .action-area {
            flex-direction: column;
            align-items: flex-start;
        }

        .update-time,
        .btn-main-action,
        .btn-outline-action {
            width: 100%;
        }

        .action-area {
            align-items: stretch;
        }
    }
</style>
