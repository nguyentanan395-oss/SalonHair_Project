@model SalonHair.Models.Booking

@{
    ViewData["Title"] = "Hủy lịch hẹn";
}

<div class="modal-header border-0">
    <h5 class="modal-title text-danger fw-bold"><i class="bi bi-exclamation-triangle me-2"></i>XÁC NHẬN HỦY LỊCH</h5>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<div class="modal-body p-4 text-center">
    <p class="text-light mb-4">
        Bạn có chắc chắn muốn xóa lịch hẹn của khách hàng <br>
        <strong class="gold-text fs-5">@Model.CustomerName</strong> <br>
        vào lúc <span class="text-warning">@Model.BookingDate.ToString("HH:mm dd/MM/yyyy")</span>?
    </p>

    <form asp-action="Delete" id="deleteBookingForm">
        <input type="hidden" asp-for="Id" />
        <div class="d-grid gap-2">
            <button type="submit" class="btn btn-danger fw-bold">XÁC NHẬN XÓA VĨNH VIỄN</button>
            <a asp-action="Index" class="btn btn-outline-light">QUAY LẠI</a>
        </div>
    </form>
</div>