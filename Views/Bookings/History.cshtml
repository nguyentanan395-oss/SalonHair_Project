@model IEnumerable<SalonHair.Models.Booking>
@{
    ViewData["Title"] = "Lịch sử hoạt động";
    var orders = ViewBag.Orders as IEnumerable<SalonHair.Models.Order>;
    bool isAuthenticated = ViewBag.IsAuthenticated as bool? ?? false;
    string? phone = ViewBag.Phone as string;
    string? userName = ViewBag.UserName as string;
}

<div class="container py-5">
    <div class="text-center mb-5">
        <h2 class="text-warning fw-bold text-uppercase"><i class="bi bi-clock-history me-2"></i> Lịch sử hoạt động</h2>
        @if (isAuthenticated)
        {
            <p class="text-secondary">Chỉ hiển thị lịch sử của tài khoản: <span class="text-white fw-bold">@userName</span></p>
        }
        else if (!string.IsNullOrEmpty(phone))
        {
            <p class="text-secondary">Dữ liệu cho số điện thoại: <span class="text-white fw-bold">@phone</span></p>
        }
        @if (!isAuthenticated)
        {
            <div class="row justify-content-center mt-3">
                <div class="col-md-4">
                    <form method="get" asp-action="History" class="input-group">
                        <input type="text" name="phone" class="form-control bg-dark text-white border-warning" placeholder="Nhập số điện thoại để tra cứu..." value="@phone">
                        <button class="btn btn-warning" type="submit"><i class="bi bi-search"></i></button>
                    </form>
                </div>
            </div>
        }
    </div>

    <div class="row">
        <!-- Lịch sử đặt lịch -->
        <div class="col-lg-7 mb-4">
            <div class="card bg-dark border-secondary shadow h-100">
                <div class="card-header bg-black border-secondary py-3">
                    <h4 class="card-title text-warning mb-0"><i class="bi bi-calendar-check me-2"></i> Lịch sử đặt dịch vụ</h4>
                </div>
                <div class="card-body p-0">
                    @if (Model != null && Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-dark table-hover mb-0">
                                <thead class="table-black">
                                    <tr>
                                        <th>Ngày hẹn</th>
                                        <th>Dịch vụ</th>
                                        <th>Khách hàng</th>
                                        <th class="text-center">Trạng thái</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td class="align-middle">@item.BookingDate.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td class="align-middle text-warning fw-bold">@item.Service?.ServiceName</td>
                                            <td class="align-middle text-secondary">@item.CustomerName</td>
                                            <td class="text-center align-middle">
                                                <span class="badge bg-info text-dark">Đã nhận lịch</span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="p-5 text-center">
                            <i class="bi bi-calendar-x text-secondary" style="font-size: 3rem;"></i>
                            <p class="mt-3 text-secondary">Bạn chưa có lịch hẹn nào.</p>
                            <a href="/Bookings/DatLich" class="btn btn-outline-warning mt-2">Đặt lịch ngay</a>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Lịch sử mua hàng -->
        <div class="col-lg-5 mb-4">
            <div class="card bg-dark border-secondary shadow h-100">
                <div class="card-header bg-black border-secondary py-3">
                    <h4 class="card-title text-success mb-0"><i class="bi bi-bag-check me-2"></i> Đơn hàng sản phẩm</h4>
                </div>
                <div class="card-body p-0">
                    @if (orders != null && orders.Any())
                    {
                        <div class="list-group list-group-flush bg-transparent">
                            @foreach (var order in orders)
                            {
                                <div class="list-group-item bg-transparent border-secondary text-white py-3">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <h6 class="mb-0 text-info">Đơn hàng #@order.Id</h6>
                                        <span class="badge bg-success">Hoàn thành</span>
                                    </div>
                                    <p class="small text-secondary mb-1">Ngày: @order.OrderDate.ToString("dd/MM/yyyy")</p>
                                    <div class="d-flex justify-content-between">
                                        <span class="small">Tổng tiền:</span>
                                        <span class="text-warning fw-bold">@order.TotalAmount.ToString("N0") VNĐ</span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="p-5 text-center">
                            <i class="bi bi-cart-x text-secondary" style="font-size: 3rem;"></i>
                            <p class="mt-3 text-secondary">Bạn chưa mua sản phẩm nào.</p>
                            <a href="/Products" class="btn btn-outline-success mt-2">Mua sắm ngay</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .table-dark tbody tr, .list-group-item {
        transition: all 0.3s ease;
        border-bottom: 1px solid rgba(255,255,255,0.05);
    }

    .table-dark tbody tr:hover, 
    .list-group-item:hover {
        background-color: transparent !important;
        transform: translateY(-4px);
        box-shadow: 0 8px 20px rgba(0,0,0,0.5);
        position: relative;
        z-index: 2;
    }
</style>