@model IEnumerable<SalonHair.Models.Booking>

@{
    ViewData["Title"] = "Quản lý Đặt lịch";
}

<div class="container-fluid py-4">
    <!-- Dashboard Stats -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card bg-dark border-gold-card text-light shadow-sm">
                <div class="card-body">
                    <h6 class="text-uppercase small gold-text">Tổng số lịch hẹn</h6>
                    <h2 class="fw-bold">@Model.Count()</h2>
                    <i class="bi bi-calendar-check position-absolute top-0 end-0 m-3 fs-1 opacity-25"></i>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-dark border-gold-card text-light shadow-sm">
                <div class="card-body">
                    <h6 class="text-uppercase small gold-text">Hôm nay</h6>
                    <h2 class="fw-bold">@Model.Count(b => b.BookingDate.Date == DateTime.Today)</h2>
                    <i class="bi bi-clock-history position-absolute top-0 end-0 m-3 fs-1 opacity-25"></i>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-dark border-gold-card text-light shadow-sm">
                <div class="card-body">
                    <h6 class="text-uppercase small gold-text">Khách mới</h6>
                    <h2 class="fw-bold">@Model.Select(b => b.Phone).Distinct().Count()</h2>
                    <i class="bi bi-people position-absolute top-0 end-0 m-3 fs-1 opacity-25"></i>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning text-dark shadow-sm">
                <div class="card-body">
                    <h6 class="text-uppercase small fw-bold">Trạng thái</h6>
                    <h2 class="fw-bold">Hoạt động</h2>
                    <i class="bi bi-shield-check position-absolute top-0 end-0 m-3 fs-1 opacity-25"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="card bg-dark border-gold-card shadow-lg overflow-hidden">
        <div class="card-header bg-dark border-bottom border-secondary d-flex justify-content-between align-items-center py-3 px-4">
            <h4 class="mb-0 gold-text fw-bold"><i class="bi bi-list-stars me-2"></i>DANH SÁCH ĐẶT LỊCH HẸN</h4>
            <div>
                <a asp-action="Create" class="btn btn-warning btn-sm fw-bold shadow-sm px-3">
                    <i class="bi bi-plus-lg me-1"></i> THÊM LỊCH MỚI
                </a>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-dark table-hover mb-0 custom-admin-table">
                    <thead>
                        <tr class="bg-black text-warning small text-uppercase fw-bold">
                            <th class="ps-4">Khách hàng</th>
                            <th>Số điện thoại</th>
                            <th>Dịch vụ</th>
                            <th>Ngày đặt</th>
                            <th class="text-center pe-4">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr class="align-middle">
                                <td class="ps-4 fw-bold">
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-circle me-3">@item.CustomerName[0]</div>
                                        @item.CustomerName
                                    </div>
                                </td>
                                <td><i class="bi bi-telephone text-muted me-2"></i>@item.Phone</td>
                                <td>
                                    <span class="badge bg-outline-gold px-3 py-2">
                                        @item.Service?.ServiceName
                                    </span>
                                </td>
                                <td>
                                    <div class="small fw-bold">@item.BookingDate.ToString("dd/MM/yyyy")</div>
                                    <div class="small text-muted">@item.BookingDate.ToString("HH:mm")</div>
                                </td>
                                <td class="text-center pe-4">
                                    <div class="btn-group shadow-sm">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning btn-sm" title="Sửa">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info btn-sm" title="Chi tiết">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm" title="Xóa">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    :root {
        --salon-gold: #d4af37;
    }
    body { background-color: #0b0b0b; }
    .gold-text { color: var(--salon-gold) !important; }
    .border-gold-card { border: 1px solid rgba(212, 175, 55, 0.3) !important; }
    
    .avatar-circle {
        width: 32px;
        height: 32px;
        background-color: var(--salon-gold);
        color: #000;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 0.8rem;
    }

    .bg-outline-gold {
        border: 1px solid var(--salon-gold);
        color: var(--salon-gold);
        background: transparent;
    }

    .custom-admin-table tbody tr {
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        transition: all 0.2s ease;
    }

    .custom-admin-table tbody tr:hover {
        background-color: rgba(212, 175, 55, 0.05) !important;
    }

    .btn-group .btn {
        padding: 0.4rem 0.8rem;
    }

    .table th {
        border-top: none;
        padding-top: 1.2rem;
        padding-bottom: 1.2rem;
        letter-spacing: 1px;
    }
</style>
