@model IEnumerable<SalonHair.Models.Booking>

@{
    ViewData["Title"] = "Quản lý Đặt lịch";

    var today = DateTime.Now.Date;
    var todayBookings = Model.Count(b => b.BookingDate.Date == today);
}


<div class="booking-page">
    <div class="booking-card">


    <div class="page-header">
        <div>
            <h2>
                <i class="bi bi-calendar2-check-fill me-2"></i>
                Quản lý đặt lịch
            </h2>
            <p>Theo dõi lịch hẹn, khách hàng, dịch vụ và thao tác quản trị lịch salon</p>
        </div>

        <a asp-action="Create" class="btn-create-booking">
            <i class="bi bi-plus-circle-fill me-2"></i>
            Thêm lịch mới
        </a>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="stat-card">
                <i class="bi bi-calendar-check-fill"></i>
                <h3>@Model.Count()</h3>
                <span>Tổng lịch hẹn</span>
            </div>
        </div>

        <div class="col-md-3">
            <div class="stat-card">
                <i class="bi bi-clock-history"></i>
                <h3>@todayBookings</h3>
                <span>Lịch hẹn hôm nay</span>
            </div>
        </div>

        <div class="col-md-3">
            <div class="stat-card">
                <i class="bi bi-people-fill"></i>
                <h3>@Model.Select(b => b.Phone).Distinct().Count()</h3>
                <span>Khách đã đặt</span>
            </div>
        </div>

        <div class="col-md-3">
            <div class="stat-card gold">
                <i class="bi bi-shield-check"></i>
                <h3>Online</h3>
                <span>Hệ thống hoạt động</span>
            </div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-box">
            <i class="bi bi-calendar-x"></i>
            <p>Chưa có lịch hẹn nào trong hệ thống.</p>
        </div>
    }
    else
    {
        <div class="table-wrapper">
            <table class="table table-dark align-middle luxury-table mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Khách hàng</th>
                        <th>Số điện thoại</th>
                        <th>Dịch vụ</th>
                        <th>Ngày hẹn</th>
                        <th class="text-center pe-4">Thao tác</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="customer-info">
                                    <div class="avatar-circle">
                                        @(string.IsNullOrEmpty(item.CustomerName) ? "?" : item.CustomerName.Substring(0, 1).ToUpper())
                                    </div>

                                    <div>
                                        <div class="customer-name">@item.CustomerName</div>
                                        <small class="text-secondary">Mã lịch #@item.Id</small>
                                    </div>
                                </div>
                            </td>

                            <td>
                                <span class="phone-text">
                                    <i class="bi bi-telephone-fill me-2"></i>
                                    @item.Phone
                                </span>
                            </td>

                            <td>
                                <span class="service-badge">
                                    <i class="bi bi-scissors me-1"></i>
                                    @(item.Service?.ServiceName ?? "Chưa chọn dịch vụ")
                                </span>
                            </td>

                            <td>
                                <div class="date-box">
                                    <strong>@item.BookingDate.ToString("dd/MM/yyyy")</strong>
                                    <small>@item.BookingDate.ToString("HH:mm")</small>
                                </div>
                            </td>

                            <td class="text-center pe-4">
                                <div class="action-group">
                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="action-btn edit-btn"
                                       title="Sửa lịch hẹn">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>

                                    <a asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="action-btn view-btn"
                                       title="Xem chi tiết">
                                        <i class="bi bi-eye-fill"></i>
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.Id"
                                       class="action-btn cancel-btn"
                                       title="Hủy lịch hẹn">
                                        <i class="bi bi-calendar-x-fill"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

</div>


</div>

<style>
    body {
        background: #050505 !important;
    }

    .booking-page {
        min-height: calc(100vh - 80px);
        padding: 40px 15px;
        background:
            radial-gradient(circle at top left, rgba(212,175,55,0.12), transparent 35%),
            linear-gradient(135deg, #050505, #111);
    }

    .booking-card {
        max-width: 1250px;
        margin: auto;
        padding: 28px;
        border-radius: 28px;
        background: linear-gradient(145deg, #151515, #222);
        border: 1px solid rgba(212,175,55,0.42);
        box-shadow: 0 30px 70px rgba(0,0,0,.72);
    }

    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 26px;
        padding-bottom: 22px;
        border-bottom: 1px solid rgba(212,175,55,.22);
    }

    .page-header h2 {
        color: #d4af37;
        font-weight: 900;
        text-transform: uppercase;
        margin: 0;
    }

    .page-header p {
        color: #bfbfbf;
        margin: 6px 0 0;
    }

    .btn-create-booking {
        padding: 13px 23px;
        border-radius: 30px;
        background: linear-gradient(135deg, #d4af37, #f5d76e);
        color: #111;
        font-weight: 900;
        text-transform: uppercase;
        text-decoration: none;
        white-space: nowrap;
        box-shadow: 0 10px 25px rgba(212,175,55,.22);
        transition: .25s;
    }

    .btn-create-booking:hover {
        transform: translateY(-2px);
        color: #111;
        box-shadow: 0 14px 30px rgba(212,175,55,.32);
    }

    .stat-card {
        height: 135px;
        padding: 22px;
        border-radius: 22px;
        background: rgba(255,255,255,.035);
        border: 1px solid rgba(212,175,55,.22);
        color: #fff;
        position: relative;
        overflow: hidden;
    }

    .stat-card i {
        color: #d4af37;
        font-size: 30px;
    }

    .stat-card h3 {
        margin: 8px 0 0;
        font-weight: 900;
        font-size: 31px;
    }

    .stat-card span {
        color: #bfbfbf;
        font-size: 14px;
    }

    .stat-card::after {
        content: "";
        position: absolute;
        right: -35px;
        bottom: -35px;
        width: 110px;
        height: 110px;
        border-radius: 50%;
        border: 1px solid rgba(212,175,55,.22);
    }

    .stat-card.gold {
        background: linear-gradient(145deg, rgba(212,175,55,.16), rgba(255,255,255,.035));
    }

    .empty-box {
        padding: 45px;
        text-align: center;
        border-radius: 22px;
        color: #d4af37;
        border: 1px dashed rgba(212,175,55,.35);
        background: rgba(212,175,55,.05);
    }

    .empty-box i {
        font-size: 42px;
        margin-bottom: 10px;
    }

    .empty-box p {
        margin: 0;
        font-weight: 700;
    }

    .table-wrapper {
        overflow: hidden;
        border-radius: 20px;
        border: 1px solid rgba(255,255,255,.07);
    }

    .luxury-table thead tr {
        background: #080808;
        color: #d4af37;
        text-transform: uppercase;
        font-size: 13px;
        letter-spacing: .7px;
    }

    .luxury-table th,
    .luxury-table td {
        padding: 18px 16px;
        border-color: rgba(255,255,255,.06);
    }

    .luxury-table tbody tr:hover {
        background: rgba(212,175,55,.07) !important;
    }

    .customer-info {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .avatar-circle {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: linear-gradient(135deg, #d4af37, #f5d76e);
        color: #111;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 900;
        box-shadow: 0 0 18px rgba(212,175,55,.28);
    }

    .customer-name {
        color: #fff;
        font-weight: 900;
    }

    .phone-text {
        color: #e8e8e8;
        font-weight: 600;
    }

    .phone-text i {
        color: #d4af37;
    }

    .service-badge {
        display: inline-flex;
        align-items: center;
        padding: 7px 12px;
        border-radius: 30px;
        color: #d4af37;
        background: rgba(212,175,55,.1);
        border: 1px solid rgba(212,175,55,.28);
        font-size: 12px;
        font-weight: 800;
    }

    .date-box strong {
        display: block;
        color: #fff;
        font-size: 14px;
    }

    .date-box small {
        color: #999;
        font-weight: 700;
    }

    .action-group {
        display: flex;
        justify-content: center;
        gap: 7px;
    }

    .action-btn {
        width: 38px;
        height: 38px;
        border-radius: 12px;
        border: 1px solid;
        background: transparent;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        transition: .2s;
    }

    .edit-btn {
        color: #d4af37;
        border-color: rgba(212,175,55,.45);
    }

    .view-btn {
        color: #0dcaf0;
        border-color: rgba(13,202,240,.45);
    }

    .cancel-btn {
        color: #dc3545;
        border-color: rgba(220,53,69,.45);
    }

    .action-btn:hover {
        transform: translateY(-2px);
        background: rgba(255,255,255,.06);
    }

    @@media (max-width: 768px) {
        .page-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .btn-create-booking {
            width: 100%;
            text-align: center;
        }

        .action-group {
            justify-content: flex-start;
        }
    }
</style>
