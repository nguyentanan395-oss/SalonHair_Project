@model SalonHair.Models.Booking

@{
    ViewData["Title"] = "Chi tiết lịch hẹn";
}

<div class="modal-header">
    <h5 class="modal-title gold-text fw-bold"><i class="bi bi-info-circle me-2"></i>THÔNG TIN LỊCH HẸN</h5>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<div class="modal-body p-4 text-light">
    <div class="row mb-3">
        <div class="col-5 fw-bold gold-text"><i class="bi bi-person me-2"></i>Khách hàng:</div>
        <div class="col-7">@Model.CustomerName</div>
    </div>
    <div class="row mb-3">
        <div class="col-5 fw-bold gold-text"><i class="bi bi-telephone me-2"></i>Điện thoại:</div>
        <div class="col-7">@Model.Phone</div>
    </div>
    <div class="row mb-3">
        <div class="col-5 fw-bold gold-text"><i class="bi bi-scissors me-2"></i>Dịch vụ:</div>
        <div class="col-7">
            <span class="badge bg-warning text-dark px-3">@Model.Service?.ServiceName</span>
        </div>
    </div>
    <div class="row mb-4">
        <div class="col-5 fw-bold gold-text"><i class="bi bi-clock me-2"></i>Thời gian:</div>
        <div class="col-7 text-warning">@Model.BookingDate.ToString("HH:mm - dd/MM/yyyy")</div>
    </div>

    <hr class="border-secondary opacity-25">
    <div class="d-flex justify-content-end gap-2">
        <a asp-action="Index" class="btn btn-outline-light">ĐÓNG</a>
    </div>
</div>