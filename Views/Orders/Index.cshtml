@model IEnumerable<SalonHair.Models.Order>

@{
    ViewData["Title"] = "Quản lý Đơn hàng Shop";
}

<div class="container-fluid py-4">
    <!-- Dashboard Stats -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card bg-dark border-gold-card text-light shadow-sm">
                <div class="card-body">
                    <h6 class="text-uppercase small gold-text">Tổng số đơn hàng</h6>
                    <h2 class="fw-bold">@Model.Count()</h2>
                    <i class="bi bi-box-seam position-absolute top-0 end-0 m-3 fs-1 opacity-25"></i>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-dark border-gold-card text-light shadow-sm">
                <div class="card-body">
                    <h6 class="text-uppercase small gold-text">Tổng doanh thu</h6>
                    <h2 class="fw-bold text-success">@Model.Sum(o => o.TotalAmount).ToString("N0") đ</h2>
                    <i class="bi bi-cash-stack position-absolute top-0 end-0 m-3 fs-1 opacity-25"></i>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-warning text-dark shadow-sm">
                <div class="card-body">
                    <h6 class="text-uppercase small fw-bold">Đơn hôm nay</h6>
                    <h2 class="fw-bold">@Model.Count(o => o.OrderDate.Date == DateTime.Today)</h2>
                    <i class="bi bi-calendar-day position-absolute top-0 end-0 m-3 fs-1 opacity-25"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="card bg-dark border-gold-card shadow-lg overflow-hidden">
        <div class="card-header bg-dark border-bottom border-secondary d-flex justify-content-between align-items-center py-3 px-4">
            <h4 class="mb-0 gold-text fw-bold"><i class="bi bi-list-stars me-2"></i>DANH SÁCH ĐƠN HÀNG SẢN PHẨM</h4>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-dark table-hover mb-0 custom-admin-table">
                    <thead>
                        <tr class="bg-black text-warning small text-uppercase fw-bold">
                            <th class="ps-4">Mã Đơn</th>
                            <th>Khách hàng</th>
                            <th>Số điện thoại</th>
                            <th>Ngày đặt</th>
                            <th>Tổng tiền</th>
                            <th class="text-center pe-4">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center text-secondary py-4">Chưa có đơn hàng nào</td>
                            </tr>
                        }
                        @foreach (var item in Model)
                        {
                            <tr class="align-middle">
                                <td class="ps-4 fw-bold text-warning">#@item.Id</td>
                                <td class="fw-bold">
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-circle me-3">@item.CustomerName[0]</div>
                                        @item.CustomerName
                                    </div>
                                </td>
                                <td><i class="bi bi-telephone text-muted me-2"></i>@item.Phone</td>
                                <td>
                                    <div class="small fw-bold">@item.OrderDate.ToString("dd/MM/yyyy")</div>
                                    <div class="small text-muted">@item.OrderDate.ToString("HH:mm")</div>
                                </td>
                                <td><span class="badge bg-success px-3 py-2">@item.TotalAmount.ToString("N0") VNĐ</span></td>
                                <td class="text-center pe-4">
                                    <div class="btn-group shadow-sm">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info btn-sm" title="Chi tiết">
                                            <i class="bi bi-eye"></i> Xem
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline;" onsubmit="return confirm('Bạn có chắc chắn muốn xóa đơn hàng này?');">
                                            <button type="submit" class="btn btn-outline-danger btn-sm" title="Xóa">
                                                <i class="bi bi-trash"></i> Xóa
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    :root {
        --salon-gold: #d4af37;
    }
    .gold-text { color: var(--salon-gold) !important; }
    .border-gold-card { border: 1px solid rgba(212, 175, 55, 0.3) !important; }
    
    .avatar-circle {
        width: 32px;
        height: 32px;
        background-color: var(--salon-gold);
        color: #000;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 0.8rem;
    }

    .custom-admin-table tbody tr {
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        transition: all 0.2s ease;
        position: relative;
    }

    .custom-admin-table tbody tr:hover {
        background-color: transparent !important;
        transform: translateY(-3px);
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.4);
        z-index: 1;
    }

    .table th {
        border-top: none;
        padding-top: 1.2rem;
        padding-bottom: 1.2rem;
        letter-spacing: 1px;
    }
</style>
