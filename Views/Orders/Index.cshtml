@model IEnumerable<SalonHair.Models.Order>

@{
ViewData["Title"] = "Quản lý Đơn hàng Shop";


var today = DateTime.Now.Date;
var totalOrders = Model.Count();
var totalRevenue = Model.Sum(o => o.TotalAmount);
var todayOrders = Model.Count(o => o.OrderDate.Date == today);


}

<div class="order-page">
    <div class="order-card">


    <div class="page-header">
        <div>
            <h2>
                <i class="bi bi-bag-check-fill me-2"></i>
                Quản lý đơn hàng shop
            </h2>
            <p>Theo dõi đơn hàng sản phẩm, khách hàng, doanh thu và thao tác quản trị</p>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="stat-card">
                <i class="bi bi-box-seam-fill"></i>
                <h3>@totalOrders</h3>
                <span>Tổng số đơn hàng</span>
            </div>
        </div>

        <div class="col-md-4">
            <div class="stat-card revenue">
                <i class="bi bi-cash-stack"></i>
                <h3>@totalRevenue.ToString("N0")đ</h3>
                <span>Tổng doanh thu</span>
            </div>
        </div>

        <div class="col-md-4">
            <div class="stat-card gold">
                <i class="bi bi-calendar-day-fill"></i>
                <h3>@todayOrders</h3>
                <span>Đơn hàng hôm nay</span>
            </div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-box">
            <i class="bi bi-bag-x"></i>
            <p>Chưa có đơn hàng nào trong hệ thống.</p>
        </div>
    }
    else
    {
        <div class="table-wrapper">
            <table class="table table-dark align-middle luxury-table mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Đơn hàng</th>
                        <th>Khách hàng</th>
                        <th>Số điện thoại</th>
                        <th>Ngày đặt</th>
                        <th>Tổng tiền</th>
                        <th class="text-center pe-4">Thao tác</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <span class="order-code">
                                    <i class="bi bi-receipt-cutoff me-1"></i>
                                    #@item.Id
                                </span>
                            </td>

                            <td>
                                <div class="customer-info">
                                    <div class="avatar-circle">
                                        @(string.IsNullOrEmpty(item.CustomerName) ? "?" : item.CustomerName.Substring(0, 1).ToUpper())
                                    </div>

                                    <div>
                                        <div class="customer-name">
                                            @item.CustomerName
                                        </div>
                                        <small class="text-secondary">
                                            Khách mua sản phẩm
                                        </small>
                                    </div>
                                </div>
                            </td>

                            <td>
                                <span class="phone-text">
                                    <i class="bi bi-telephone-fill me-2"></i>
                                    @item.Phone
                                </span>
                            </td>

                            <td>
                                <div class="date-box">
                                    <strong>@item.OrderDate.ToString("dd/MM/yyyy")</strong>
                                    <small>@item.OrderDate.ToString("HH:mm")</small>
                                </div>
                            </td>

                            <td>
                                <span class="price-badge">
                                    <i class="bi bi-cash-coin me-1"></i>
                                    @item.TotalAmount.ToString("N0") VNĐ
                                </span>
                            </td>

                            <td class="text-center pe-4">
                                <div class="action-group">
                                    <a asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="action-btn view-btn"
                                       title="Xem chi tiết">
                                        <i class="bi bi-eye-fill"></i>
                                    </a>

                                    <form asp-action="Delete"
                                          asp-route-id="@item.Id"
                                          method="post"
                                          onsubmit="return confirm('Bạn có chắc chắn muốn xóa đơn hàng này?');">
                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="action-btn delete-btn"
                                                title="Xóa đơn hàng">
                                            <i class="bi bi-trash-fill"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

</div>


</div>

<style>
    body {
        background: #050505 !important;
    }

    .order-page {
        min-height: calc(100vh - 80px);
        padding: 40px 15px;
        background:
            radial-gradient(circle at top left, rgba(212,175,55,0.12), transparent 35%),
            linear-gradient(135deg, #050505, #111);
    }

    .order-card {
        max-width: 1250px;
        margin: auto;
        padding: 28px;
        border-radius: 28px;
        background: linear-gradient(145deg, #151515, #222);
        border: 1px solid rgba(212,175,55,0.42);
        box-shadow: 0 30px 70px rgba(0,0,0,.72);
    }

    .page-header {
        margin-bottom: 26px;
        padding-bottom: 22px;
        border-bottom: 1px solid rgba(212,175,55,.22);
    }

    .page-header h2 {
        color: #d4af37;
        font-weight: 900;
        text-transform: uppercase;
        margin: 0;
    }

    .page-header p {
        color: #bfbfbf;
        margin: 6px 0 0;
    }

    .stat-card {
        height: 135px;
        padding: 22px;
        border-radius: 22px;
        background: rgba(255,255,255,.035);
        border: 1px solid rgba(212,175,55,.22);
        color: #fff;
        position: relative;
        overflow: hidden;
    }

    .stat-card i {
        color: #d4af37;
        font-size: 30px;
    }

    .stat-card h3 {
        margin: 8px 0 0;
        font-weight: 900;
        font-size: 29px;
    }

    .stat-card span {
        color: #bfbfbf;
        font-size: 14px;
    }

    .stat-card::after {
        content: "";
        position: absolute;
        right: -35px;
        bottom: -35px;
        width: 110px;
        height: 110px;
        border-radius: 50%;
        border: 1px solid rgba(212,175,55,.22);
    }

    .stat-card.revenue i,
    .stat-card.revenue h3 {
        color: #75d69c;
    }

    .stat-card.gold {
        background: linear-gradient(145deg, rgba(212,175,55,.16), rgba(255,255,255,.035));
    }

    .empty-box {
        padding: 45px;
        text-align: center;
        border-radius: 22px;
        color: #d4af37;
        border: 1px dashed rgba(212,175,55,.35);
        background: rgba(212,175,55,.05);
    }

    .empty-box i {
        font-size: 42px;
        margin-bottom: 10px;
    }

    .empty-box p {
        margin: 0;
        font-weight: 700;
    }

    .table-wrapper {
        overflow: hidden;
        border-radius: 20px;
        border: 1px solid rgba(255,255,255,.07);
    }

    .luxury-table thead tr {
        background: #080808;
        color: #d4af37;
        text-transform: uppercase;
        font-size: 13px;
        letter-spacing: .7px;
    }

    .luxury-table th,
    .luxury-table td {
        padding: 18px 16px;
        border-color: rgba(255,255,255,.06);
    }

    .luxury-table tbody tr:hover {
        background: rgba(212,175,55,.07) !important;
    }

    .order-code {
        display: inline-flex;
        align-items: center;
        padding: 7px 12px;
        border-radius: 30px;
        color: #d4af37;
        background: rgba(212,175,55,.1);
        border: 1px solid rgba(212,175,55,.28);
        font-size: 13px;
        font-weight: 900;
    }

    .customer-info {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .avatar-circle {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: linear-gradient(135deg, #d4af37, #f5d76e);
        color: #111;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 900;
        box-shadow: 0 0 18px rgba(212,175,55,.28);
    }

    .customer-name {
        color: #fff;
        font-weight: 900;
    }

    .phone-text {
        color: #e8e8e8;
        font-weight: 600;
    }

    .phone-text i {
        color: #d4af37;
    }

    .date-box strong {
        display: block;
        color: #fff;
        font-size: 14px;
    }

    .date-box small {
        color: #999;
        font-weight: 700;
    }

    .price-badge {
        display: inline-flex;
        align-items: center;
        padding: 8px 13px;
        border-radius: 30px;
        color: #75d69c;
        background: rgba(25,135,84,.15);
        border: 1px solid rgba(25,135,84,.38);
        font-size: 13px;
        font-weight: 900;
    }

    .action-group {
        display: flex;
        justify-content: center;
        gap: 8px;
    }

    .action-group form {
        margin: 0;
    }

    .action-btn {
        width: 39px;
        height: 39px;
        border-radius: 12px;
        border: 1px solid;
        background: transparent;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        transition: .2s;
        cursor: pointer;
    }

    .view-btn {
        color: #0dcaf0;
        border-color: rgba(13,202,240,.45);
    }

    .delete-btn {
        color: #dc3545;
        border-color: rgba(220,53,69,.45);
    }

    .action-btn:hover {
        transform: translateY(-2px);
        background: rgba(255,255,255,.06);
    }

    @@media (max-width: 768px) {
        .action-group {
            justify-content: flex-start;
        }
    }
</style>
