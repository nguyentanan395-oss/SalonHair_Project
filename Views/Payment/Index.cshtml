@model IEnumerable<SalonHair.Models.Payment>

@{
ViewData["Title"] = "Quản lý thanh toán";


var totalPayments = Model.Count();
var completedPayments = Model.Count(p => p.Status == "Đã thanh toán");
var pendingPayments = Model.Count(p => p.Status != "Đã thanh toán");
var totalAmount = Model.Where(p => p.Status == "Đã thanh toán").Sum(p => p.Amount);


}

<div class="payment-page">
    <div class="payment-card">


    <div class="page-header">
        <div>
            <h2>
                <i class="bi bi-credit-card-2-front-fill me-2"></i>
                Quản lý giao dịch thanh toán
            </h2>
            <p>Theo dõi giao dịch đặt lịch, đơn hàng, minh chứng và trạng thái thanh toán</p>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="stat-card">
                <i class="bi bi-receipt-cutoff"></i>
                <h3>@totalPayments</h3>
                <span>Tổng giao dịch</span>
            </div>
        </div>

        <div class="col-md-3">
            <div class="stat-card revenue">
                <i class="bi bi-cash-stack"></i>
                <h3>@totalAmount.ToString("N0")đ</h3>
                <span>Doanh thu hoàn tất</span>
            </div>
        </div>

        <div class="col-md-3">
            <div class="stat-card success">
                <i class="bi bi-check-circle-fill"></i>
                <h3>@completedPayments</h3>
                <span>Đã thanh toán</span>
            </div>
        </div>

        <div class="col-md-3">
            <div class="stat-card gold">
                <i class="bi bi-hourglass-split"></i>
                <h3>@pendingPayments</h3>
                <span>Đang xử lý</span>
            </div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-box">
            <i class="bi bi-wallet2"></i>
            <p>Chưa có giao dịch thanh toán nào trong hệ thống.</p>
        </div>
    }
    else
    {
        <div class="table-wrapper">
            <table class="table table-dark align-middle luxury-table mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Giao dịch</th>
                        <th>Loại GD</th>
                        <th>Tham chiếu</th>
                        <th>Số tiền</th>
                        <th>Phương thức</th>
                        <th>Ngày tạo</th>
                        <th class="text-center">Trạng thái</th>
                        <th class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <span class="payment-code">
                                    <i class="bi bi-receipt me-1"></i>
                                    #@item.PaymentId
                                </span>
                            </td>

                            <td>
                                @if (item.BookingId != null)
                                {
                                    <span class="type-badge booking-type">
                                        <i class="bi bi-calendar-event me-1"></i>
                                        Đặt lịch
                                    </span>
                                }
                                else if (item.OrderId != null)
                                {
                                    <span class="type-badge order-type">
                                        <i class="bi bi-bag-check me-1"></i>
                                        Đơn hàng
                                    </span>
                                }
                                else
                                {
                                    <span class="type-badge unknown-type">
                                        <i class="bi bi-question-circle me-1"></i>
                                        Khác
                                    </span>
                                }
                            </td>

                            <td>
                                <span class="reference-text">
                                    @(item.BookingId != null ? $"BK-{item.BookingId}" : item.OrderId != null ? $"ORD-{item.OrderId}" : "N/A")
                                </span>
                            </td>

                            <td>
                                <span class="amount-badge">
                                    <i class="bi bi-cash-coin me-1"></i>
                                    @item.Amount.ToString("N0")đ
                                </span>
                            </td>

                            <td>
                                <span class="method-box">
                                    <i class="bi @(item.Method == "Cash" ? "bi-cash-coin" : "bi-credit-card-2-front") me-2"></i>
                                    @item.Method
                                </span>
                            </td>

                            <td>
                                <div class="date-box">
                                    <strong>@item.CreatedAt.ToString("dd/MM/yyyy")</strong>
                                    <small>@item.CreatedAt.ToString("HH:mm")</small>
                                </div>
                            </td>

                            <td class="text-center">
                                @if (item.Status == "Đã thanh toán")
                                {
                                    <span class="status-badge success-status">
                                        <i class="bi bi-check-circle-fill me-1"></i>
                                        Hoàn tất
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge pending-status">
                                        <i class="bi bi-clock-history me-1"></i>
                                        @item.Status
                                    </span>
                                }
                            </td>

                            <td class="text-end pe-4">
                                <div class="action-group">
                                    @if (!string.IsNullOrEmpty(item.ProofImage))
                                    {
                                        <button type="button"
                                                class="action-btn proof-btn"
                                                data-bs-toggle="modal"
                                                data-bs-target="#proofModal-@item.PaymentId"
                                                title="Xem ảnh minh chứng">
                                            <i class="bi bi-image-fill"></i>
                                        </button>
                                    }

                                    @if (item.Status != "Đã thanh toán")
                                    {
                                        <button type="button"
                                                class="action-btn confirm-btn"
                                                data-bs-toggle="modal"
                                                data-bs-target="#confirmModal-@item.PaymentId"
                                                title="Xác nhận thanh toán">
                                            <i class="bi bi-check-lg"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

</div>


</div>

@foreach (var item in Model)
{
@if (!string.IsNullOrEmpty(item.ProofImage))
{ <div class="modal fade" id="proofModal-@item.PaymentId" tabindex="-1"> <div class="modal-dialog modal-dialog-centered modal-lg"> <div class="modal-content luxury-modal"> <div class="modal-header"> <h5 class="modal-title text-info fw-bold"> <i class="bi bi-image-fill me-2"></i>
Minh chứng thanh toán </h5> <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button> </div>

                <div class="modal-body proof-body">
                    <img src="@item.ProofImage"
                         class="proof-image"
                         alt="Proof of Payment" />
                </div>
            </div>
        </div>
    </div>
}

<div class="modal fade" id="confirmModal-@item.PaymentId" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content luxury-modal">
            <div class="modal-header">
                <h5 class="modal-title text-warning fw-bold">
                    <i class="bi bi-shield-check me-2"></i>
                    Xác nhận giao dịch
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body text-center">
                <div class="modal-icon-success">
                    <i class="bi bi-cash-coin"></i>
                </div>

                <p class="text-secondary mb-1">Xác nhận đã nhận đủ số tiền</p>

                <h3 class="text-warning fw-bold mb-3">
                    @item.Amount.ToString("N0")đ
                </h3>

                <p class="mb-0">
                    Cập nhật trạng thái thanh toán thành
                    <strong class="text-success">Hoàn tất</strong>.
                </p>
            </div>

            <div class="modal-footer justify-content-center">
                <button type="button"
                        class="btn btn-outline-light px-4"
                        data-bs-dismiss="modal">
                    Hủy
                </button>

                <form asp-action="Confirm"
                      asp-route-id="@item.PaymentId"
                      method="post">
                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn btn-warning fw-bold px-4 text-dark">
                        Xác nhận
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>


}

<style>
    body {
        background: #050505 !important;
    }

    .payment-page {
        min-height: calc(100vh - 80px);
        padding: 40px 15px;
        background:
            radial-gradient(circle at top left, rgba(212,175,55,0.12), transparent 35%),
            linear-gradient(135deg, #050505, #111);
    }

    .payment-card {
        max-width: 1300px;
        margin: auto;
        padding: 28px;
        border-radius: 28px;
        background: linear-gradient(145deg, #151515, #222);
        border: 1px solid rgba(212,175,55,0.42);
        box-shadow: 0 30px 70px rgba(0,0,0,.72);
    }

    .page-header {
        margin-bottom: 26px;
        padding-bottom: 22px;
        border-bottom: 1px solid rgba(212,175,55,.22);
    }

    .page-header h2 {
        color: #d4af37;
        font-weight: 900;
        text-transform: uppercase;
        margin: 0;
    }

    .page-header p {
        color: #bfbfbf;
        margin: 6px 0 0;
    }

    .stat-card {
        height: 135px;
        padding: 22px;
        border-radius: 22px;
        background: rgba(255,255,255,.035);
        border: 1px solid rgba(212,175,55,.22);
        color: #fff;
        position: relative;
        overflow: hidden;
    }

    .stat-card i {
        color: #d4af37;
        font-size: 30px;
    }

    .stat-card h3 {
        margin: 8px 0 0;
        font-weight: 900;
        font-size: 26px;
    }

    .stat-card span {
        color: #bfbfbf;
        font-size: 14px;
    }

    .stat-card::after {
        content: "";
        position: absolute;
        right: -35px;
        bottom: -35px;
        width: 110px;
        height: 110px;
        border-radius: 50%;
        border: 1px solid rgba(212,175,55,.22);
    }

    .stat-card.revenue i,
    .stat-card.revenue h3,
    .stat-card.success i,
    .stat-card.success h3 {
        color: #75d69c;
    }

    .stat-card.gold {
        background: linear-gradient(145deg, rgba(212,175,55,.16), rgba(255,255,255,.035));
    }

    .empty-box {
        padding: 45px;
        text-align: center;
        border-radius: 22px;
        color: #d4af37;
        border: 1px dashed rgba(212,175,55,.35);
        background: rgba(212,175,55,.05);
    }

    .empty-box i {
        font-size: 42px;
        margin-bottom: 10px;
    }

    .empty-box p {
        margin: 0;
        font-weight: 700;
    }

    .table-wrapper {
        overflow: hidden;
        border-radius: 20px;
        border: 1px solid rgba(255,255,255,.07);
    }

    .luxury-table thead tr {
        background: #080808;
        color: #d4af37;
        text-transform: uppercase;
        font-size: 13px;
        letter-spacing: .7px;
    }

    .luxury-table th,
    .luxury-table td {
        padding: 18px 16px;
        border-color: rgba(255,255,255,.06);
    }

    .luxury-table tbody tr:hover {
        background: rgba(212,175,55,.07) !important;
    }

    .payment-code,
    .type-badge,
    .amount-badge,
    .status-badge,
    .method-box {
        display: inline-flex;
        align-items: center;
        padding: 7px 12px;
        border-radius: 30px;
        font-size: 12px;
        font-weight: 800;
    }

    .payment-code {
        color: #d4af37;
        background: rgba(212,175,55,.1);
        border: 1px solid rgba(212,175,55,.28);
    }

    .booking-type {
        color: #0dcaf0;
        background: rgba(13,202,240,.12);
        border: 1px solid rgba(13,202,240,.35);
    }

    .order-type {
        color: #6ea8fe;
        background: rgba(13,110,253,.12);
        border: 1px solid rgba(13,110,253,.35);
    }

    .unknown-type {
        color: #adb5bd;
        background: rgba(108,117,125,.15);
        border: 1px solid rgba(108,117,125,.35);
    }

    .reference-text {
        color: #e8e8e8;
        font-weight: 800;
    }

    .amount-badge {
        color: #d4af37;
        background: rgba(212,175,55,.1);
        border: 1px solid rgba(212,175,55,.28);
    }

    .method-box {
        color: #e8e8e8;
        background: rgba(255,255,255,.04);
        border: 1px solid rgba(255,255,255,.08);
    }

    .method-box i {
        color: #d4af37;
    }

    .date-box strong {
        display: block;
        color: #fff;
        font-size: 14px;
    }

    .date-box small {
        color: #999;
        font-weight: 700;
    }

    .success-status {
        color: #75d69c;
        background: rgba(25,135,84,.15);
        border: 1px solid rgba(25,135,84,.38);
    }

    .pending-status {
        color: #ffc107;
        background: rgba(255,193,7,.13);
        border: 1px solid rgba(255,193,7,.38);
    }

    .action-group {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
    }

    .action-btn {
        width: 39px;
        height: 39px;
        border-radius: 12px;
        border: 1px solid;
        background: transparent;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        transition: .2s;
        cursor: pointer;
    }

    .proof-btn {
        color: #0dcaf0;
        border-color: rgba(13,202,240,.45);
    }

    .confirm-btn {
        color: #d4af37;
        border-color: rgba(212,175,55,.45);
    }

    .action-btn:hover {
        transform: translateY(-2px);
        background: rgba(255,255,255,.06);
    }

    .luxury-modal {
        background: linear-gradient(145deg, #151515, #222);
        color: #fff;
        border: 1px solid rgba(212,175,55,.42);
        border-radius: 22px;
        overflow: hidden;
        box-shadow: 0 25px 70px rgba(0,0,0,.75);
    }

    .luxury-modal .modal-header,
    .luxury-modal .modal-footer {
        border-color: rgba(255,255,255,.08);
    }

    .proof-body {
        background: #050505;
        padding: 18px;
        text-align: center;
    }

    .proof-image {
        max-width: 100%;
        max-height: 70vh;
        border-radius: 16px;
        border: 1px solid rgba(212,175,55,.25);
        box-shadow: 0 20px 50px rgba(0,0,0,.65);
    }

    .modal-icon-success {
        width: 78px;
        height: 78px;
        margin: 0 auto 18px;
        border-radius: 50%;
        background: rgba(25,135,84,.12);
        color: #28d17c;
        border: 1px solid rgba(25,135,84,.45);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 35px;
    }

    .modal-content,
    .modal-content:hover,
    .modal-dialog,
    .modal-dialog:hover {
        transform: none !important;
        transition: none !important;
        animation: none !important;
    }

    .modal.fade .modal-dialog {
        transition: none !important;
        transform: none !important;
    }

    .modal.show .modal-dialog {
        transform: none !important;
    }

    .modal-backdrop {
        opacity: .85 !important;
    }

    @@media (max-width: 768px) {
        .action-group {
            justify-content: flex-start;
        }
    }
</style>
