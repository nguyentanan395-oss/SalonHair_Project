@{
    ViewData["Title"] = "Đặt hàng thành công";
}

<div class="row mt-5">
    <div class="col-md-8 offset-md-2 text-center">
        <div class="card bg-dark text-light border-0 shadow py-5">
            <div class="card-body">
                <i class="bi bi-check-circle-fill text-success" style="font-size: 5rem;"></i>
                <h1 class="text-warning fw-bold mt-3">ĐẶT HÀNG THÀNH CÔNG!</h1>
                <p class="lead mt-3">Cảm ơn bạn đã mua sắm tại <strong>Salon Hair Luxury</strong>.</p>
                <p class="text-secondary">Đơn hàng của bạn đã được ghi nhận vào hệ thống và sẽ được xử lý trong thời gian sớm nhất. Chúng tôi sẽ liên hệ với bạn để xác nhận giao hàng.</p>
                
                <div class="mt-5">
                    <a asp-controller="Products" asp-action="Index" class="btn btn-warning btn-lg fw-bold px-4">
                        <i class="bi bi-shop"></i> Mua Thêm Sản Phẩm
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
