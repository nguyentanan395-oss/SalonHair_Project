@model IEnumerable<SalonHair.Models.CartItem>

@{
    ViewData["Title"] = "Giỏ Hàng";
}

<h2 class="text-warning fw-bold mb-4"><i class="bi bi-cart3"></i> Giỏ Hàng Của Bạn</h2>

@if (!Model.Any())
{
    <div class="alert alert-info bg-dark text-light border-0 shadow-sm text-center py-5">
        <h4>Giỏ hàng của bạn đang trống!</h4>
        <a asp-controller="Products" asp-action="Index" class="btn btn-warning mt-3">Quay lại mua sắm</a>
    </div>
}
else
{
    <div class="card bg-dark text-light border-0 shadow-sm mb-4">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-dark table-striped align-middle">
                    <thead>
                        <tr>
                            <th scope="col">Hình</th>
                            <th scope="col">Sản phẩm</th>
                            <th scope="col">Giá</th>
                            <th scope="col" class="text-center">Số lượng</th>
                            <th scope="col">Thành tiền</th>
                            <th scope="col"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td style="width: 80px;">
                                    <img src="@(string.IsNullOrEmpty(item.Product.ImageUrl) ? "https://via.placeholder.com/60" : item.Product.ImageUrl)" class="img-fluid rounded" style="width: 60px; height: 60px; object-fit: cover;" />
                                </td>
                                <td><span class="text-warning fw-bold">@item.Product.Name</span></td>
                                <td>@item.Product.Price.ToString("N0") VNĐ</td>
                                <td class="text-center">@item.Quantity</td>
                                <td><strong class="text-success">@((item.Product.Price * item.Quantity).ToString("N0")) VNĐ</strong></td>
                                <td class="text-end">
                                    <a asp-action="RemoveFromCart" asp-route-id="@item.Product.Id" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> Xóa</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 offset-md-6">
            <div class="card bg-dark text-light border border-warning shadow">
                <div class="card-body">
                    <h4 class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-warning">Tổng cộng:</span>
                        <span class="text-success fw-bold">@Model.Sum(x => x.Product.Price * x.Quantity).ToString("N0") VNĐ</span>
                    </h4>
                    <hr class="border-secondary" />
                    <div class="d-grid gap-2">
                        <a asp-action="Checkout" class="btn btn-warning btn-lg fw-bold"><i class="bi bi-credit-card"></i> Thanh Toán Ngay</a>
                        <a asp-controller="Products" asp-action="Index" class="btn btn-outline-light mt-2">Tiếp tục mua sắm</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
