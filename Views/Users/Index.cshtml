@model IEnumerable<SalonHair.Models.User>
@{
    ViewData["Title"] = "Quản lý người dùng";
}
<h2 class="text-primary">Quản lý người dùng</h2>
<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Id</th>
            <th>Tên đăng nhập</th>
            <th>Email</th>
            <th>Quyền</th>
            <th>Hành động</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var user in Model)
    {
        <tr>
            <td>@user.Id</td>
            <td>@user.Username</td>
            <td>@user.Email</td>
            <td>@user.Role?.RoleName</td>
            <td>
                <a asp-controller="Users" asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-warning">Sửa</a>
            </td>
        </tr>
    }
    </tbody>
</table>
