@model IEnumerable<SalonHair.Models.User>

@{
ViewData["Title"] = "Quản lý người dùng";
}

<div class="user-manage-page">
    <div class="user-manage-card">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show luxury-alert" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show luxury-alert" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="page-header">
        <div>
            <h2>
                <i class="bi bi-people-fill me-2"></i>
                Quản lý tài khoản hệ thống
            </h2>
            <p>Theo dõi, phân quyền, khóa hoặc mở khóa tài khoản người dùng</p>
        </div>

        <a asp-action="Create" class="btn-create-user">
            <i class="bi bi-person-plus-fill me-1"></i>
            Tạo tài khoản mới
        </a>
    </div>

    <div class="table-wrapper">
        <table class="table table-dark align-middle luxury-table mb-0">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Tên đăng nhập</th>
                    <th>Email</th>
                    <th>Quyền hạn</th>
                    <th class="text-center">Trạng thái</th>
                    <th class="text-center">Thao tác</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td class="text-secondary fw-bold">#@user.Id</td>

                        <td>
                            <div class="user-info">
                                <div class="avatar-gold">
                                    @user.Username.Substring(0, 1).ToUpper()
                                </div>
                                <span>@user.Username</span>
                            </div>
                        </td>

                        <td class="text-light-50">@user.Email</td>

                        <td>
                            @if (user.RoleId == 2)
                            {
                                <span class="role-badge role-admin">
                                    <i class="bi bi-shield-lock-fill me-1"></i>
                                    Admin
                                </span>
                            }
                            else if (user.RoleId == 3)
                            {
                                <span class="role-badge role-staff">
                                    <i class="bi bi-person-badge-fill me-1"></i>
                                    Staff
                                </span>
                            }
                            else
                            {
                                <span class="role-badge role-customer">
                                    <i class="bi bi-person-fill me-1"></i>
                                    Customer
                                </span>
                            }
                        </td>

                        <td class="text-center">
                            @if (user.IsLocked)
                            {
                                <span class="status-badge status-locked">
                                    <i class="bi bi-lock-fill me-1"></i>
                                    Đã khóa
                                </span>
                            }
                            else
                            {
                                <span class="status-badge status-active">
                                    <i class="bi bi-unlock-fill me-1"></i>
                                    Hoạt động
                                </span>
                            }
                        </td>

                        <td class="text-center">
                            <div class="action-group">
                                <button type="button"
                                        class="action-btn edit-btn"
                                        data-bs-toggle="modal"
                                        data-bs-target="#editModal-@user.Id"
                                        title="Chỉnh sửa">
                                    <i class="bi bi-pencil-square"></i>
                                </button>

                                <button type="button"
                                        class="action-btn @(user.IsLocked ? "lock-btn" : "unlock-btn")"
                                        data-bs-toggle="modal"
                                        data-bs-target="#lockModal-@user.Id"
                                        title="@(user.IsLocked ? "Tài khoản đang khóa - bấm để mở khóa" : "Tài khoản đang mở - bấm để khóa")">
                                    <i class="bi @(user.IsLocked ? "bi-lock-fill" : "bi-unlock-fill")"></i>
                                </button>

                                <button type="button"
                                        class="action-btn delete-btn"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deleteModal-@user.Id"
                                        title="Xóa tài khoản">
                                    <i class="bi bi-trash-fill"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>


</div>

@foreach (var user in Model)
{ <div class="modal fade" id="editModal-@user.Id" tabindex="-1"> <div class="modal-dialog modal-dialog-centered"> <div class="modal-content luxury-modal"> <div class="modal-header"> <h5 class="modal-title text-warning fw-bold"> <i class="bi bi-pencil-square me-2"></i>
Chỉnh sửa tài khoản </h5> <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button> </div>


            <form id="editUserForm-@user.Id"
                  class="ajax-edit-form"
                  asp-action="Edit"
                  asp-route-id="@user.Id"
                  method="post">
                @Html.AntiForgeryToken()

                <div class="modal-body">
                    <input type="hidden" name="Id" value="@user.Id" />

                    <div class="mb-3">
                        <label class="form-label">Tên đăng nhập</label>
                        <input type="text" name="Username" value="@user.Username" class="form-control luxury-input" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input type="email" name="Email" value="@user.Email" class="form-control luxury-input" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Quyền hạn</label>
                        <select name="RoleId" class="form-select luxury-input">
                            <option value="1" selected="@(user.RoleId == 1)">Customer</option>
                            <option value="2" selected="@(user.RoleId == 2)">Admin</option>
                            <option value="3" selected="@(user.RoleId == 3)">Staff</option>
                        </select>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-warning fw-bold">Lưu thay đổi</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteModal-@user.Id" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content luxury-modal danger-modal">
            <div class="modal-header">
                <h5 class="modal-title text-danger fw-bold">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    Xác nhận xóa tài khoản
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body text-center">
                <div class="modal-icon-danger">
                    <i class="bi bi-trash-fill"></i>
                </div>

                <p class="mb-0">
                    Bạn có chắc muốn xóa tài khoản
                    <br />
                    <strong class="text-warning">@user.Username</strong>
                    không?
                </p>
            </div>

            <div class="modal-footer justify-content-center">
                <button type="button" class="btn btn-outline-light px-4" data-bs-dismiss="modal">Hủy</button>

                <form asp-action="Delete" asp-route-id="@user.Id" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger px-4 fw-bold">Xóa</button>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="lockModal-@user.Id" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content luxury-modal">
            <div class="modal-header">
                <h5 class="modal-title fw-bold @(user.IsLocked ? "text-success" : "text-warning")">
                    <i class="bi @(user.IsLocked ? "bi-unlock-fill" : "bi-lock-fill") me-2"></i>
                    @(user.IsLocked ? "Mở khóa tài khoản" : "Khóa tài khoản")
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body text-center">
                <div class="modal-icon @(user.IsLocked ? "modal-icon-success" : "modal-icon-warning")">
                    <i class="bi @(user.IsLocked ? "bi-unlock-fill" : "bi-lock-fill")"></i>
                </div>

                <p>
                    Bạn có chắc muốn
                    <strong class="@(user.IsLocked ? "text-success" : "text-warning")">
                        @(user.IsLocked ? "mở khóa" : "khóa")
                    </strong>
                    tài khoản
                    <br />
                    <strong class="text-warning">@user.Username</strong>
                    không?
                </p>
            </div>

            <div class="modal-footer justify-content-center">
                <button type="button" class="btn btn-outline-light px-4" data-bs-dismiss="modal">Hủy</button>

                <form asp-action="LockUnlock" asp-route-id="@user.Id" method="post">
                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn px-4 fw-bold @(user.IsLocked ? "btn-success" : "btn-warning")">
                        @(user.IsLocked ? "Mở khóa" : "Khóa")
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>


}

<script>
    document.querySelectorAll('.ajax-edit-form').forEach(function (form) {
        form.addEventListener('submit', async function (e) {
            e.preventDefault();

            const submitBtn = form.querySelector('button[type="submit"]');
            const originalText = submitBtn.innerHTML;
            const modalId = 'editModal-' + form.getAttribute('id').replace('editUserForm-', '');
            const modal = bootstrap.Modal.getInstance(document.getElementById(modalId));

            submitBtn.disabled = true;
            submitBtn.innerHTML = 'Đang lưu...';

            try {
                const response = await fetch(form.action, {
                    method: 'POST',
                    body: new FormData(form),
                    headers: {
                        'RequestVerificationToken': form.querySelector('input[name="__RequestVerificationToken"]').value,
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });

                const result = await response.json();

                if (result.success) {
                    if (modal) modal.hide();
                    window.location.reload();
                } else {
                    alert(result.message || 'Cập nhật thất bại.');
                }
            } catch (error) {
                console.error(error);
                alert('Có lỗi xảy ra khi cập nhật.');
            } finally {
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalText;
            }
        });
    });
</script>

<style>
    body {
        background: #050505 !important;
    }

    .user-manage-page {
        min-height: calc(100vh - 80px);
        padding: 40px 15px;
        background:
            radial-gradient(circle at top left, rgba(212,175,55,0.12), transparent 35%),
            linear-gradient(135deg, #050505, #111);
    }

    .user-manage-card {
        max-width: 1250px;
        margin: auto;
        padding: 28px;
        border-radius: 26px;
        background: linear-gradient(145deg, #151515, #222);
        border: 1px solid rgba(212,175,55,0.45);
        box-shadow: 0 30px 70px rgba(0,0,0,0.7);
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 26px;
        padding-bottom: 22px;
        border-bottom: 1px solid rgba(212,175,55,0.25);
    }

    .page-header h2 {
        color: #d4af37;
        font-weight: 900;
        text-transform: uppercase;
        margin: 0;
    }

    .page-header p {
        color: #bfbfbf;
        margin: 6px 0 0;
    }

    .btn-create-user {
        padding: 12px 22px;
        border-radius: 30px;
        background: linear-gradient(135deg, #d4af37, #f5d76e);
        color: #111;
        font-weight: 900;
        text-decoration: none;
        white-space: nowrap;
        box-shadow: 0 10px 25px rgba(212,175,55,0.22);
    }

    .table-wrapper {
        overflow: hidden;
        border-radius: 18px;
        border: 1px solid rgba(255,255,255,0.08);
    }

    .luxury-table thead tr {
        background: #080808;
        color: #d4af37;
        text-transform: uppercase;
        font-size: 13px;
        letter-spacing: .7px;
    }

    .luxury-table th,
    .luxury-table td {
        padding: 18px 16px;
        border-color: rgba(255,255,255,0.06);
    }

    .luxury-table tbody tr:hover {
        background: rgba(212,175,55,0.07) !important;
    }

    .user-info {
        display: flex;
        align-items: center;
        gap: 12px;
        font-weight: 800;
        color: #fff;
    }

    .avatar-gold {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background: linear-gradient(135deg, #d4af37, #f5d76e);
        color: #111;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 900;
    }

    .role-badge,
    .status-badge {
        display: inline-flex;
        align-items: center;
        padding: 7px 12px;
        border-radius: 30px;
        font-size: 12px;
        font-weight: 800;
    }

    .role-admin {
        background: rgba(13,110,253,.15);
        color: #6ea8fe;
        border: 1px solid rgba(13,110,253,.35);
    }

    .role-staff {
        background: rgba(13,202,240,.15);
        color: #6edff6;
        border: 1px solid rgba(13,202,240,.35);
    }

    .role-customer {
        background: rgba(108,117,125,.2);
        color: #d1d1d1;
        border: 1px solid rgba(108,117,125,.35);
    }

    .status-locked {
        background: rgba(220,53,69,.15);
        color: #ff6b7a;
        border: 1px solid rgba(220,53,69,.45);
    }

    .status-active {
        background: rgba(25,135,84,.15);
        color: #75d69c;
        border: 1px solid rgba(25,135,84,.45);
    }

    .action-group {
        display: flex;
        justify-content: center;
        gap: 7px;
    }

    .action-btn {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        border: 1px solid;
        background: transparent;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: .2s;
    }

    .edit-btn {
        color: #d4af37;
        border-color: rgba(212,175,55,.45);
    }

    .lock-btn {
        color: #ffc107;
        border-color: rgba(255,193,7,.45);
    }

    .unlock-btn {
        color: #20c997;
        border-color: rgba(32,201,151,.45);
    }

    .delete-btn {
        color: #dc3545;
        border-color: rgba(220,53,69,.45);
    }

    .action-btn:hover {
        transform: translateY(-2px);
        background: rgba(255,255,255,.06);
    }

    .luxury-modal {
        background: linear-gradient(145deg, #151515, #222);
        color: #fff;
        border: 1px solid rgba(212,175,55,.45);
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 25px 70px rgba(0,0,0,.75);
    }

    .luxury-modal .modal-header,
    .luxury-modal .modal-footer {
        border-color: rgba(255,255,255,.08);
    }

    .luxury-input {
        min-height: 46px;
        border-radius: 12px;
        background: #2b2b2b;
        color: #fff;
        border: 1px solid rgba(212,175,55,.25);
    }

    .luxury-input:focus {
        background: #303030;
        color: #fff;
        border-color: #d4af37;
        box-shadow: 0 0 0 3px rgba(212,175,55,.22);
    }

    .modal-icon,
    .modal-icon-danger {
        width: 76px;
        height: 76px;
        margin: 0 auto 18px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 34px;
    }

    .modal-icon-warning {
        background: rgba(255,193,7,.12);
        color: #ffc107;
        border: 1px solid rgba(255,193,7,.45);
    }

    .modal-icon-success {
        background: rgba(25,135,84,.12);
        color: #28d17c;
        border: 1px solid rgba(25,135,84,.45);
    }

    .modal-icon-danger {
        background: rgba(220,53,69,.12);
        color: #dc3545;
        border: 1px solid rgba(220,53,69,.45);
    }

    @@media (max-width: 768px) {
        .page-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .btn-create-user {
            width: 100%;
            text-align: center;
        }
    }
</style>
