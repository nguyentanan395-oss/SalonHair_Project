@model IEnumerable<SalonHair.Models.Service>

@{
    ViewData["Title"] = "Quản lý Dịch vụ";
}

<div class="container py-4">
    <div class="card bg-dark border-gold-card shadow-lg">
        <div class="card-header bg-dark border-bottom border-secondary d-flex justify-content-between align-items-center py-3 px-4">
            <h4 class="mb-0 gold-text fw-bold"><i class="bi bi-scissors me-2"></i>DANH MỤC DỊCH VỤ SALON</h4>
            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Create" class="btn btn-warning btn-sm fw-bold px-3">
                    <i class="bi bi-plus-circle me-1"></i> THÊM DỊCH VỤ
                </a>
            }
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-dark table-hover mb-0 custom-admin-table">
                    <thead>
                        <tr class="bg-black text-warning small text-uppercase fw-bold">
                            <th class="ps-4">Tên dịch vụ</th>
                            <th>Giá tiền (VNĐ)</th>
                            <th style="width: 40%;">Mô tả chi tiết</th>
                            @if (User.IsInRole("Admin"))
                            {
                                <th class="text-center pe-4">Thao tác</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr class="align-middle">
                                <td class="ps-4 fw-bold">@item.ServiceName</td>
                                <td>
                                    <span class="text-warning fw-bold">@item.Price.ToString("N0")</span>
                                </td>
                                <td>
                                    <small class="text-wrap d-block" style="color: #28a745; font-weight: 500;">@item.Description</small>
                                </td>
                                @if (User.IsInRole("Admin"))
                                {
                                    <td class="text-center pe-4">
                                        <div class="btn-group shadow-sm">
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning btn-sm">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info btn-sm">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .gold-text { color: #d4af37 !important; }
    .border-gold-card { border: 1px solid rgba(212, 175, 55, 0.3) !important; }
    .custom-admin-table tbody tr:hover {
        background-color: rgba(212, 175, 55, 0.03) !important;
    }
    .table th { letter-spacing: 1px; padding: 1rem 0.5rem; }
</style>
