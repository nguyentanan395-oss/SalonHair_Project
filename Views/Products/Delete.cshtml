@model SalonHair.Models.Product

<div class="card bg-dark border-danger shadow-lg border-2 animate__animated animate__zoomIn">
<div class="card bg-black border-danger shadow-lg border-2 animate__animated animate__bounceIn" style="border-radius: 20px;">
    <div class="card-body p-5 text-center">
        <div class="mb-4">
            <div class="d-inline-flex align-items-center justify-content-center bg-danger bg-opacity-10 rounded-circle mb-3" style="width: 80px; height: 80px;">
                <i class="bi bi-trash3-fill text-danger" style="font-size: 2.5rem;"></i>
            <div class="d-inline-flex align-items-center justify-content-center bg-danger bg-opacity-10 rounded-circle mb-3 shadow-sm" style="width: 90px; height: 90px; border: 1px solid rgba(220, 53, 69, 0.2);">
                <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size: 3rem;"></i>
            </div>
        </div>
        <h3 class="text-white fw-bold mb-2">XÁC NHẬN XÓA</h3>
        <p class="text-light-emphasis mb-4 px-3">
            Bạn có chắc chắn muốn xóa vĩnh viễn sản phẩm <span class="gold-text fw-bold">@Model.Name</span>?<br />
            Hành động này không thể hoàn tác.
        <h2 class="text-white fw-bold mb-3">XÁC NHẬN XÓA?</h2>
        <p class="text-secondary mb-5 px-2 fs-6">
            Bạn sắp gỡ bỏ sản phẩm <span class="text-warning fw-bold">@Model.Name</span> khỏi hệ thống.<br />
            Hành động này <span class="text-danger fw-bold">không thể hoàn tác</span>. Bạn chắc chắn chứ?
        </p>

        <form asp-action="DeleteConfirmed" asp-route-id="@Model.Id" method="post">
            <div class="d-flex flex-column gap-2">
                <button type="submit" class="btn btn-danger btn-lg fw-bold py-2 shadow-sm">
                    <i class="bi bi-check-lg me-2"></i>XÁC NHẬN XÓA
            <div class="d-grid gap-3">
                <button type="submit" class="btn btn-danger btn-lg fw-bold py-3 shadow">
                    <i class="bi bi-trash3 me-2"></i> XÁC NHẬN XÓA VĨNH VIỄN
                </button>
                <button type="button" class="btn btn-link text-light text-decoration-none small opacity-75" data-bs-dismiss="modal">
                    Quay lại danh sách
                <button type="button" class="btn btn-outline-light py-2 opacity-75" data-bs-dismiss="modal">
                    HỦY BỎ
                </button>
            </div>
        </form>
    </div>
</div>