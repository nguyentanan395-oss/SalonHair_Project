@using Microsoft.AspNetCore.Http
@using SalonHair.Models
@model IEnumerable<SalonHair.Models.Product>

@{
    ViewData["Title"] = "Cửa hàng Sản Phẩm";
    // Lấy giỏ hàng từ Session và tính tổng số lượng
    var cart = Context.Session.Get<List<CartItem>>("Cart") ?? new List<CartItem>();
    var totalItems = cart.Sum(i => i.Quantity);
}

<div class="row mb-4 align-items-center">
    <div class="col-md-8">
        <h2 class="text-warning fw-bold"><i class="bi bi-shop me-2"></i> Cửa Hàng Sản Phẩm</h2>
        <p class="text-secondary">Chăm sóc tóc chuyên nghiệp với các sản phẩm cao cấp phân phối chính hãng.</p>
    </div>
    <div class="col-md-4 text-md-end mt-3 mt-md-0">
        <a asp-controller="Cart" asp-action="Index" class="btn btn-warning fw-bold">
            <i class="bi bi-cart3"></i> Xem Giỏ Hàng 
            @if (totalItems > 0)
            {
                <span class="badge bg-danger rounded-pill ms-1">@totalItems</span>
            }
        </a>
    </div>
</div>

<div class="row row-cols-1 row-cols-md-3 g-4">
    @foreach (var item in Model)
    {
        <div class="col">
            <div class="card h-100 shadow-sm border-0 mb-3 bg-dark text-white">
                <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "https://via.placeholder.com/400x300?text=No+Image" : item.ImageUrl)" class="card-img-top p-2" alt="@item.Name" style="height: 250px; object-fit: cover; border-radius:10px;" />
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title text-warning fw-bold">@item.Name</h5>
                    <p class="card-text text-light" style="flex-grow: 1;">@item.Description</p>
                    <h4 class="text-success mb-3 fw-bold">@item.Price.ToString("N0") VNĐ</h4>
                    <a asp-controller="Cart" asp-action="AddToCart" asp-route-id="@item.Id" class="btn btn-outline-warning w-100 mt-auto fw-bold"><i class="bi bi-cart-plus"></i> Thêm vào giỏ</a>
                </div>
            </div>
        </div>
    }
</div>
