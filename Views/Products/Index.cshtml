@using Microsoft.AspNetCore.Http
@using SalonHair.Models
@model IEnumerable<SalonHair.Models.Product>

@{
    ViewData["Title"] = "Cửa hàng Sản Phẩm";
    // Lấy giỏ hàng từ Session và tính tổng số lượng
    var cart = Context.Session.Get<List<CartItem>>("Cart") ?? new List<CartItem>();
    var totalItems = cart.Sum(i => i.Quantity);
}

<div class="row mb-4 align-items-center">
    <div class="col-md-5">
        <h2 class="text-warning fw-bold"><i class="bi bi-shop-window me-2"></i> Cửa Hàng Sản Phẩm</h2>
        <p class="text-secondary">Chăm sóc tóc chuyên nghiệp với các sản phẩm cao cấp phân phối chính hãng.</p>
    </div>
    <div class="col-md-4 mt-3 mt-md-0">
        <div class="input-group">
            <span class="input-group-text bg-dark border-warning text-warning"><i class="bi bi-search"></i></span>
            <input type="text" id="productSearch" class="form-control bg-dark text-white border-warning" placeholder="Tìm kiếm sản phẩm...">
        </div>
    </div>
    <div class="col-md-3 text-md-end mt-3 mt-md-0">
        <a asp-controller="Cart" asp-action="Index" class="btn btn-warning fw-bold">
            <i class="bi bi-bag-check-fill me-1"></i> Xem Giỏ Hàng 
            @if (totalItems > 0)
            {
                <span class="badge bg-danger rounded-pill ms-1">@totalItems</span>
            }
        </a>
    </div>
</div>

<div class="row row-cols-1 row-cols-md-3 g-4">
    @foreach (var item in Model)
    {
        <div class="col product-item" data-name="@item.Name">
            <div class="card h-100 shadow-sm border-0 mb-3 bg-dark text-white">
                <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "https://via.placeholder.com/400x300?text=No+Image" : item.ImageUrl)" class="card-img-top p-2" alt="@item.Name" style="height: 250px; object-fit: cover; border-radius:10px;" />
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title text-warning fw-bold">@item.Name</h5>
                    <p class="card-text text-light text-truncate" style="flex-grow: 1; max-height: 3em;">@item.Description</p>
                    <h4 class="text-success mb-3 fw-bold">@item.Price.ToString("N0") VNĐ</h4>
                    <div class="d-grid gap-2 mt-auto">
                        <button type="button" 
                                class="btn btn-outline-info fw-bold btn-sm view-details" 
                                data-name="@item.Name" 
                                data-description="@item.Description" 
                                data-price="@item.Price.ToString("N0") VNĐ" 
                                data-image="@(string.IsNullOrEmpty(item.ImageUrl) ? "https://via.placeholder.com/400x300?text=No+Image" : item.ImageUrl)"
                                data-bs-toggle="modal" 
                                data-bs-target="#productDetailModal">
                            <i class="bi bi-info-circle"></i> Chi tiết
                        </button>
                        <a asp-controller="Cart" asp-action="AddToCart" asp-route-id="@item.Id" class="btn btn-outline-warning fw-bold"><i class="bi bi-cart-plus"></i> Thêm vào giỏ</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Modal Chi tiết sản phẩm -->
<div class="modal fade" id="productDetailModal" tabindex="-1" aria-labelledby="productDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-white border-warning">
            <div class="modal-header border-secondary">
                <h5 class="modal-title text-warning fw-bold" id="productDetailModalLabel">Thông tin sản phẩm</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <img id="modalProductImage" src="" class="img-fluid rounded mb-3 border border-secondary" style="max-height: 300px; object-fit: contain;">
                <h3 id="modalProductName" class="text-warning fw-bold"></h3>
                <h4 id="modalProductPrice" class="text-success fw-bold mb-3"></h4>
                <div class="p-3 bg-black rounded text-start">
                    <h6 class="text-secondary text-uppercase small">Mô tả sản phẩm:</h6>
                    <p id="modalProductDescription" class="mb-0"></p>
                </div>
            </div>
            <div class="modal-footer border-secondary">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Logic tìm kiếm sản phẩm
        document.getElementById('productSearch').addEventListener('keyup', function () {
            const searchValue = this.value.toLowerCase().trim();
            const items = document.querySelectorAll('.product-item');

            items.forEach(item => {
                const productName = item.getAttribute('data-name').toLowerCase();
                if (productName.includes(searchValue)) {
                    item.style.display = 'block';
                } else {
                    item.style.display = 'none';
                }
            });
        });

        // Logic hiển thị Modal chi tiết
        const productDetailModal = document.getElementById('productDetailModal');
        if (productDetailModal) {
            productDetailModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                
                const name = button.getAttribute('data-name');
                const description = button.getAttribute('data-description');
                const price = button.getAttribute('data-price');
                const image = button.getAttribute('data-image');

                const modalTitle = productDetailModal.querySelector('.modal-title');
                const modalName = productDetailModal.querySelector('#modalProductName');
                const modalDescription = productDetailModal.querySelector('#modalProductDescription');
                const modalPrice = productDetailModal.querySelector('#modalProductPrice');
                const modalImage = productDetailModal.querySelector('#modalProductImage');

                modalTitle.textContent = 'Chi tiết: ' + name;
                modalName.textContent = name;
                modalDescription.textContent = description || "Chưa có mô tả chi tiết cho sản phẩm này.";
                modalPrice.textContent = price;
                modalImage.src = image;
            });
        }
    </script>
}
