@model IEnumerable<SalonHair.Models.Product>

@{
ViewData["Title"] = "Quản lý Kho Sản phẩm";
}

<div class="product-manage-page">
    <div class="product-manage-card">


    <div class="page-header">
        <div>
            <h2>
                <i class="bi bi-box-seam-fill me-2"></i>
                Quản lý kho sản phẩm
            </h2>
            <p>Theo dõi sản phẩm, hình ảnh, giá bán và thao tác quản trị shop salon</p>
        </div>

        <a asp-action="Create" class="btn-create-product">
            <i class="bi bi-plus-circle-fill me-2"></i>
            Thêm sản phẩm
        </a>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="stat-card">
                <i class="bi bi-box-fill"></i>
                <h3>@Model.Count()</h3>
                <span>Tổng sản phẩm</span>
            </div>
        </div>

        <div class="col-md-4">
            <div class="stat-card">
                <i class="bi bi-cash-stack"></i>
                <h3>@Model.Sum(p => p.Price).ToString("N0")đ</h3>
                <span>Tổng giá trị niêm yết</span>
            </div>
        </div>

        <div class="col-md-4">
            <div class="stat-card gold">
                <i class="bi bi-stars"></i>
                <h3>Shop</h3>
                <span>Sản phẩm chăm sóc tóc</span>
            </div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-box">
            <i class="bi bi-box"></i>
            <p>Chưa có sản phẩm nào trong kho.</p>
        </div>
    }
    else
    {
        <div class="table-wrapper">
            <table class="table table-dark align-middle luxury-table mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Sản phẩm</th>
                        <th>Hình ảnh</th>
                        <th>Giá bán</th>
                        <th>Mô tả</th>
                        <th class="text-center pe-4">Thao tác</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div>
                                    <div class="product-name">@item.Name</div>
                                    <small class="text-secondary">Mã SP #@item.Id</small>
                                </div>
                            </td>

                            <td>
                                <div class="product-image-box">
                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        <img src="@Url.Content(item.ImageUrl)"
                                             alt="@item.Name"
                                             onerror="this.src='/images/default-product.png'" />
                                    }
                                    else
                                    {
                                        <img src="/images/default-product.png"
                                             alt="Default Product" />
                                    }
                                </div>
                            </td>

                            <td>
                                <span class="price-badge">
                                    <i class="bi bi-cash-coin me-1"></i>
                                    @item.Price.ToString("N0") đ
                                </span>
                            </td>

                            <td>
                                <div class="description-text">
                                    @(string.IsNullOrEmpty(item.Description)
                                        ? "Chưa có mô tả"
                                        : item.Description)
                                </div>
                            </td>

                            <td class="text-center pe-4">
                                <div class="action-group">
                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="action-btn edit-btn"
                                       title="Sửa sản phẩm">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>

                                    <form asp-action="Delete"
                                          asp-route-id="@item.Id"
                                          method="post"
                                          onsubmit="return confirm('Bạn có chắc chắn muốn xóa sản phẩm này?');">
                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="action-btn delete-btn"
                                                title="Xóa sản phẩm">
                                            <i class="bi bi-trash-fill"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

</div>

</div>

<style>
    body {
        background: #050505 !important;
    }

    .product-manage-page {
        min-height: calc(100vh - 80px);
        padding: 40px 15px;
        background:
            radial-gradient(circle at top left, rgba(212,175,55,0.12), transparent 35%),
            linear-gradient(135deg, #050505, #111);
    }

    .product-manage-card {
        max-width: 1250px;
        margin: auto;
        padding: 28px;
        border-radius: 28px;
        background: linear-gradient(145deg, #151515, #222);
        border: 1px solid rgba(212,175,55,0.42);
        box-shadow: 0 30px 70px rgba(0,0,0,.72);
    }

    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 26px;
        padding-bottom: 22px;
        border-bottom: 1px solid rgba(212,175,55,.22);
    }

    .page-header h2 {
        color: #d4af37;
        font-weight: 900;
        text-transform: uppercase;
        margin: 0;
    }

    .page-header p {
        color: #bfbfbf;
        margin: 6px 0 0;
    }

    .btn-create-product {
        padding: 13px 23px;
        border-radius: 30px;
        background: linear-gradient(135deg, #d4af37, #f5d76e);
        color: #111;
        font-weight: 900;
        text-transform: uppercase;
        text-decoration: none;
        white-space: nowrap;
        box-shadow: 0 10px 25px rgba(212,175,55,.22);
        transition: .25s;
    }

    .btn-create-product:hover {
        transform: translateY(-2px);
        color: #111;
        box-shadow: 0 14px 30px rgba(212,175,55,.32);
    }

    .stat-card {
        height: 135px;
        padding: 22px;
        border-radius: 22px;
        background: rgba(255,255,255,.035);
        border: 1px solid rgba(212,175,55,.22);
        color: #fff;
        position: relative;
        overflow: hidden;
    }

    .stat-card i {
        color: #d4af37;
        font-size: 30px;
    }

    .stat-card h3 {
        margin: 8px 0 0;
        font-weight: 900;
        font-size: 28px;
    }

    .stat-card span {
        color: #bfbfbf;
        font-size: 14px;
    }

    .stat-card::after {
        content: "";
        position: absolute;
        right: -35px;
        bottom: -35px;
        width: 110px;
        height: 110px;
        border-radius: 50%;
        border: 1px solid rgba(212,175,55,.22);
    }

    .stat-card.gold {
        background: linear-gradient(145deg, rgba(212,175,55,.16), rgba(255,255,255,.035));
    }

    .empty-box {
        padding: 45px;
        text-align: center;
        border-radius: 22px;
        color: #d4af37;
        border: 1px dashed rgba(212,175,55,.35);
        background: rgba(212,175,55,.05);
    }

    .empty-box i {
        font-size: 42px;
        margin-bottom: 10px;
    }

    .empty-box p {
        margin: 0;
        font-weight: 700;
    }

    .table-wrapper {
        overflow: hidden;
        border-radius: 20px;
        border: 1px solid rgba(255,255,255,.07);
    }

    .luxury-table thead tr {
        background: #080808;
        color: #d4af37;
        text-transform: uppercase;
        font-size: 13px;
        letter-spacing: .7px;
    }

    .luxury-table th,
    .luxury-table td {
        padding: 18px 16px;
        border-color: rgba(255,255,255,.06);
    }

    .luxury-table tbody tr:hover {
        background: rgba(212,175,55,.07) !important;
    }

    .product-name {
        color: #fff;
        font-weight: 900;
    }

    .product-image-box {
        width: 68px;
        height: 68px;
        padding: 4px;
        border-radius: 18px;
        background: rgba(212,175,55,.08);
        border: 1px solid rgba(212,175,55,.3);
    }

    .product-image-box img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 14px;
        display: block;
    }

    .price-badge {
        display: inline-flex;
        align-items: center;
        padding: 8px 13px;
        border-radius: 30px;
        color: #75d69c;
        background: rgba(25,135,84,.15);
        border: 1px solid rgba(25,135,84,.38);
        font-size: 13px;
        font-weight: 900;
    }

    .description-text {
        max-width: 360px;
        color: #cfcfcf;
        font-size: 14px;
        line-height: 1.5;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .action-group {
        display: flex;
        justify-content: center;
        gap: 8px;
    }

    .action-group form {
        margin: 0;
    }

    .action-btn {
        width: 39px;
        height: 39px;
        border-radius: 12px;
        border: 1px solid;
        background: transparent;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        transition: .2s;
        cursor: pointer;
    }

    .edit-btn {
        color: #d4af37;
        border-color: rgba(212,175,55,.45);
    }

    .delete-btn {
        color: #dc3545;
        border-color: rgba(220,53,69,.45);
    }

    .action-btn:hover {
        transform: translateY(-2px);
        background: rgba(255,255,255,.06);
    }

    @@media (max-width: 768px) {
        .page-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .btn-create-product {
            width: 100%;
            text-align: center;
        }

        .action-group {
            justify-content: flex-start;
        }
    }
</style>
