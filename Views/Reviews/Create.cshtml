@model SalonHair.Models.Review
@{
    ViewData["Title"] = "Đánh giá Dịch vụ";
}

<div class="row mt-4">
    <div class="col-md-8 offset-md-2">
        <div class="card bg-dark border-warning shadow-lg text-light">
            <div class="card-header border-bottom border-warning py-3 text-center">
                <h3 class="text-warning fw-bold mb-0"><i class="bi bi-star-fill text-warning me-2"></i> GÓP Ý & ĐÁNH GIÁ DỊCH VỤ</h3>
                <p class="text-secondary mt-2 mb-0">SalonHair luôn trân trọng mọi ý kiến đóng góp từ quý khách hàng!</p>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="CustomerName" class="form-label text-warning fw-bold"></label>
                        <input asp-for="CustomerName" class="form-control bg-secondary text-light border-0" placeholder="Nhập tên của bạn..." />
                        <span asp-validation-for="CustomerName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-warning fw-bold">Mức độ hài lòng (1 - 5 Sao)</label>
                        <div class="d-flex align-items-center">
                            <input type="range" asp-for="Rating" class="form-range w-50 me-3" min="1" max="5" step="1" id="ratingRange" oninput="document.getElementById('ratingValue').innerText = this.value" />
                            <span class="badge bg-warning text-dark fs-5"><span id="ratingValue">5</span> <i class="bi bi-star-fill"></i></span>
                        </div>
                        <span asp-validation-for="Rating" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Comment" class="form-label text-warning fw-bold"></label>
                        <textarea asp-for="Comment" class="form-control bg-secondary text-light border-0" rows="5" placeholder="Chia sẻ trải nghiệm của bạn (nhân viên, chất lượng...)"></textarea>
                        <span asp-validation-for="Comment" class="text-danger"></span>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-warning btn-lg fw-bold"><i class="bi bi-send me-1"></i> Gửi Đánh Giá Ngay</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.getElementById("ratingRange").value = 5;
    </script>
}
