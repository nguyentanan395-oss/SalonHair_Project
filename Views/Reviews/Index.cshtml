@model IEnumerable<SalonHair.Models.Review>

@{
ViewData["Title"] = "Quản lý Đánh giá Khách hàng";


var totalReviews = Model.Count();
var averageRating = Model.Any() ? Math.Round(Model.Average(r => r.Rating), 1) : 0;
var fiveStarReviews = Model.Count(r => r.Rating == 5);


}

<div class="review-page">
    <div class="review-card">


    <div class="page-header">
        <div>
            <h2>
                <i class="bi bi-chat-quote-fill me-2"></i>
                Quản lý đánh giá khách hàng
            </h2>
            <p>Theo dõi phản hồi, mức độ hài lòng và trải nghiệm dịch vụ từ khách hàng</p>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="stat-card gold">
                <i class="bi bi-star-fill"></i>
                <h3>@averageRating</h3>
                <span>Điểm trung bình</span>
            </div>
        </div>

        <div class="col-md-4">
            <div class="stat-card">
                <i class="bi bi-chat-dots-fill"></i>
                <h3>@totalReviews</h3>
                <span>Tổng lượt đánh giá</span>
            </div>
        </div>

        <div class="col-md-4">
            <div class="stat-card success">
                <i class="bi bi-award-fill"></i>
                <h3>@fiveStarReviews</h3>
                <span>Đánh giá 5 sao</span>
            </div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-box">
            <i class="bi bi-chat-left-text"></i>
            <p>Chưa có đánh giá nào từ khách hàng.</p>
        </div>
    }
    else
    {
        <div class="table-wrapper">
            <table class="table table-dark align-middle luxury-table mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Khách hàng</th>
                        <th>Mức độ</th>
                        <th>Nội dung góp ý</th>
                        <th>Thời gian</th>
                        <th class="text-center pe-4">Thao tác</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="customer-info">
                                    <div class="avatar-circle">
                                        @(string.IsNullOrWhiteSpace(item.CustomerName) ? "?" : item.CustomerName.Trim().Substring(0, 1).ToUpper())
                                    </div>

                                    <div>
                                        <div class="customer-name">
                                            @item.CustomerName
                                        </div>
                                        <small class="text-secondary">
                                            Mã đánh giá #@item.Id
                                        </small>
                                    </div>
                                </div>
                            </td>

                            <td>
                                <div class="rating-box">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        if (i <= item.Rating)
                                        {
                                            <i class="bi bi-star-fill"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-star"></i>
                                        }
                                    }

                                    <span>@item.Rating/5</span>
                                </div>
                            </td>

                            <td>
                                <div class="comment-box">
                                    @(string.IsNullOrWhiteSpace(item.Comment) ? "Không có nội dung góp ý." : item.Comment)
                                </div>
                            </td>

                            <td>
                                <div class="date-box">
                                    <strong>@item.CreatedAt.ToString("dd/MM/yyyy")</strong>
                                    <small>@item.CreatedAt.ToString("HH:mm")</small>
                                </div>
                            </td>

                            <td class="text-center pe-4">
                                <div class="action-group">
                                    <form asp-action="Delete"
                                          asp-route-id="@item.Id"
                                          method="post"
                                          onsubmit="return confirm('Bạn có chắc muốn xóa đánh giá này không?');">
                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="action-btn delete-btn"
                                                title="Xóa đánh giá">
                                            <i class="bi bi-trash-fill"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

</div>


</div>

<style>
    body {
        background: #050505 !important;
    }

    .review-page {
        min-height: calc(100vh - 80px);
        padding: 40px 15px;
        background:
            radial-gradient(circle at top left, rgba(212,175,55,0.12), transparent 35%),
            linear-gradient(135deg, #050505, #111);
    }

    .review-card {
        max-width: 1250px;
        margin: auto;
        padding: 28px;
        border-radius: 28px;
        background: linear-gradient(145deg, #151515, #222);
        border: 1px solid rgba(212,175,55,0.42);
        box-shadow: 0 30px 70px rgba(0,0,0,.72);
    }

    .page-header {
        margin-bottom: 26px;
        padding-bottom: 22px;
        border-bottom: 1px solid rgba(212,175,55,.22);
    }

    .page-header h2 {
        color: #d4af37;
        font-weight: 900;
        text-transform: uppercase;
        margin: 0;
    }

    .page-header p {
        color: #bfbfbf;
        margin: 6px 0 0;
    }

    .stat-card {
        height: 135px;
        padding: 22px;
        border-radius: 22px;
        background: rgba(255,255,255,.035);
        border: 1px solid rgba(212,175,55,.22);
        color: #fff;
        position: relative;
        overflow: hidden;
    }

    .stat-card i {
        color: #d4af37;
        font-size: 30px;
    }

    .stat-card h3 {
        margin: 8px 0 0;
        font-weight: 900;
        font-size: 31px;
    }

    .stat-card span {
        color: #bfbfbf;
        font-size: 14px;
    }

    .stat-card::after {
        content: "";
        position: absolute;
        right: -35px;
        bottom: -35px;
        width: 110px;
        height: 110px;
        border-radius: 50%;
        border: 1px solid rgba(212,175,55,.22);
    }

    .stat-card.gold {
        background: linear-gradient(145deg, rgba(212,175,55,.16), rgba(255,255,255,.035));
    }

    .stat-card.success i,
    .stat-card.success h3 {
        color: #75d69c;
    }

    .empty-box {
        padding: 45px;
        text-align: center;
        border-radius: 22px;
        color: #d4af37;
        border: 1px dashed rgba(212,175,55,.35);
        background: rgba(212,175,55,.05);
    }

    .empty-box i {
        font-size: 42px;
        margin-bottom: 10px;
    }

    .empty-box p {
        margin: 0;
        font-weight: 700;
    }

    .table-wrapper {
        overflow: hidden;
        border-radius: 20px;
        border: 1px solid rgba(255,255,255,.07);
    }

    .luxury-table thead tr {
        background: #080808;
        color: #d4af37;
        text-transform: uppercase;
        font-size: 13px;
        letter-spacing: .7px;
    }

    .luxury-table th,
    .luxury-table td {
        padding: 18px 16px;
        border-color: rgba(255,255,255,.06);
    }

    .luxury-table tbody tr:hover {
        background: rgba(212,175,55,.07) !important;
    }

    .customer-info {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .avatar-circle {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: linear-gradient(135deg, #d4af37, #f5d76e);
        color: #111;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 900;
        box-shadow: 0 0 18px rgba(212,175,55,.28);
    }

    .customer-name {
        color: #fff;
        font-weight: 900;
    }

    .rating-box {
        display: inline-flex;
        align-items: center;
        gap: 3px;
        color: #d4af37;
        font-weight: 800;
    }

    .rating-box span {
        margin-left: 8px;
        padding: 4px 9px;
        border-radius: 20px;
        background: rgba(212,175,55,.1);
        border: 1px solid rgba(212,175,55,.25);
        font-size: 12px;
    }

    .comment-box {
        max-width: 420px;
        color: #dcdcdc;
        line-height: 1.5;
        font-size: 14px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .date-box strong {
        display: block;
        color: #fff;
        font-size: 14px;
    }

    .date-box small {
        color: #999;
        font-weight: 700;
    }

    .action-group {
        display: flex;
        justify-content: center;
    }

    .action-group form {
        margin: 0;
    }

    .action-btn {
        width: 39px;
        height: 39px;
        border-radius: 12px;
        border: 1px solid;
        background: transparent;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: .2s;
        cursor: pointer;
    }

    .delete-btn {
        color: #dc3545;
        border-color: rgba(220,53,69,.45);
    }

    .action-btn:hover {
        transform: translateY(-2px);
        background: rgba(255,255,255,.06);
    }
</style>
