@model IEnumerable<SalonHair.Models.Review>
@{
    ViewData["Title"] = "Quản lý Đánh giá Khách hàng";
}

<div class="container-fluid py-4">
    <!-- Dashboard Stats -->
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card bg-dark border-gold-card text-light shadow-sm">
                <div class="card-body">
                    <h6 class="text-uppercase small gold-text">Tổng Điểm Trung Bình</h6>
                    <h2 class="fw-bold text-warning">
                        @(Model.Any() ? Math.Round(Model.Average(r => r.Rating), 1).ToString() : "0")
                        <i class="bi bi-star-fill fs-4"></i>
                    </h2>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card bg-dark border-gold-card text-light shadow-sm">
                <div class="card-body">
                    <h6 class="text-uppercase small gold-text">Tổng Số Lượt Đánh Giá</h6>
                    <h2 class="fw-bold">@Model.Count() Lượt</h2>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="card bg-dark border-gold-card shadow-lg overflow-hidden">
        <div class="card-header bg-dark border-bottom border-secondary py-3 px-4">
            <h4 class="mb-0 gold-text fw-bold"><i class="bi bi-chat-quote me-2"></i>FEEDBACK TỪ KHÁCH HÀNG</h4>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-dark table-hover mb-0 custom-admin-table">
                    <thead>
                        <tr class="bg-black text-warning small text-uppercase fw-bold">
                            <th class="ps-4">Khách hàng</th>
                            <th>Mức độ</th>
                            <th>Nội dung góp ý</th>
                            <th>Thời gian</th>
                            <th class="text-center pe-4">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center text-secondary py-4">Chưa có đánh giá nào từ khách hàng</td>
                            </tr>
                        }
                        @foreach (var item in Model)
                        {
                            <tr class="align-middle">
                                <td class="ps-4 fw-bold">
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-circle me-3">@item.CustomerName.Trim()[0]</div>
                                        @item.CustomerName
                                    </div>
                                </td>
                                <td>
                                    @for (int i = 0; i < item.Rating; i++)
                                    {
                                        <i class="bi bi-star-fill text-warning"></i>
                                    }
                                </td>
                                <td>
                                    <p class="mb-0" style="max-width: 350px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                        @item.Comment
                                    </p>
                                </td>
                                <td><div class="small" style="color: #28a745; font-weight: 500;">@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div></td>
                                <td class="text-center pe-4">
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Bạn có chắc muốn xóa đánh giá này không?');">
                                        <button type="submit" class="btn btn-outline-danger btn-sm" title="Xóa">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    :root {
        --salon-gold: #d4af37;
    }
    .gold-text { color: var(--salon-gold) !important; }
    .border-gold-card { border: 1px solid rgba(212, 175, 55, 0.3) !important; }
    
    .avatar-circle {
        width: 32px;
        height: 32px;
        background-color: var(--salon-gold);
        color: #000;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 0.8rem;
    }

    .custom-admin-table tbody tr {
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }
</style>
