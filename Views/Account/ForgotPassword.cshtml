@{
ViewData["Title"] = "Quên Mật Khẩu";
}

<div class="row mt-5">
    <div class="col-md-6 offset-md-3">
        <div class="card bg-dark border-gold-card shadow-lg text-light">

```
        <div class="card-header border-bottom border-warning py-3 text-center">
            <h3 class="text-warning fw-bold mb-0">
                <i class="bi bi-key-fill"></i> QUÊN MẬT KHẨU
            </h3>
        </div>

        <div class="card-body p-4">

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success">
                    @TempData["SuccessMessage"]
                </div>
            }

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <form asp-action="ForgotPassword" method="post">

                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label text-warning fw-bold">
                        Email đăng ký
                    </label>

                    <input type="email"
                           name="email"
                           class="form-control bg-white text-dark"
                           placeholder="Nhập email của bạn..."
                           required />
                </div>

                <button type="submit"
                        class="btn btn-warning w-100 fw-bold">
                    <i class="bi bi-envelope-fill"></i>
                    GỬI MÃ OTP
                </button>

            </form>

            <hr class="border-warning my-4" />

            <div class="text-center">
                <a asp-action="Login"
                   class="text-warning text-decoration-none fw-bold">
                    <i class="bi bi-arrow-left-circle"></i>
                    Quay lại đăng nhập
                </a>
            </div>

        </div>
    </div>
</div>
```

</div>

<style>
    .border-gold-card {
        border: 2px solid #ffc107;
        border-radius: 15px;
    }

    .card {
        overflow: hidden;
    }

    .form-control {
        height: 48px;
    }

    .form-control:focus {
        border-color: #ffc107;
        box-shadow: 0 0 10px rgba(255,193,7,.4);
    }

    .btn-warning {
        height: 48px;
        font-size: 16px;
    }
</style>
