@{
ViewData["Title"] = "Đặt lại mật khẩu";
}

<div class="row mt-5">
    <div class="col-md-6 offset-md-3">
        <div class="card bg-dark border-gold-card shadow-lg text-light">

```
        <div class="card-header border-bottom border-warning py-3 text-center">
            <h3 class="text-warning fw-bold mb-0">
                <i class="bi bi-shield-lock-fill"></i>
                ĐẶT LẠI MẬT KHẨU
            </h3>
        </div>

        <div class="card-body p-4">

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <form asp-action="ResetPassword" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" name="email" value="@ViewBag.Email" />

                <div class="mb-3">
                    <label class="form-label text-warning fw-bold">Mã OTP</label>
                    <input type="text"
                           name="otpCode"
                           class="form-control bg-white text-dark"
                           placeholder="Nhập mã OTP từ email"
                           maxlength="6"
                           required />
                </div>

                <div class="mb-3">
                    <label class="form-label text-warning fw-bold">Mật khẩu mới</label>

                    <div class="input-group">
                        <input type="password"
                               id="newPassword"
                               name="newPassword"
                               class="form-control bg-white text-dark"
                               placeholder="Nhập mật khẩu mới"
                               required />

                        <button type="button"
                                class="btn btn-outline-warning"
                                onclick="togglePassword('newPassword', 'iconNewPassword')">
                            <i id="iconNewPassword" class="bi bi-eye"></i>
                        </button>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label text-warning fw-bold">Xác nhận mật khẩu</label>

                    <div class="input-group">
                        <input type="password"
                               id="confirmPassword"
                               name="confirmPassword"
                               class="form-control bg-white text-dark"
                               placeholder="Nhập lại mật khẩu mới"
                               required />

                        <button type="button"
                                class="btn btn-outline-warning"
                                onclick="togglePassword('confirmPassword', 'iconConfirmPassword')">
                            <i id="iconConfirmPassword" class="bi bi-eye"></i>
                        </button>
                    </div>
                </div>

                <button type="submit" class="btn btn-warning w-100 fw-bold mt-3">
                    <i class="bi bi-check-circle-fill"></i>
                    ĐẶT LẠI MẬT KHẨU
                </button>
            </form>

            <hr class="border-warning my-4">

            <div class="text-center">
                <a asp-action="Login"
                   class="text-warning text-decoration-none fw-bold">
                    <i class="bi bi-arrow-left-circle"></i>
                    Quay lại đăng nhập
                </a>
            </div>

        </div>
    </div>
</div>
```

</div>

<style>
    .border-gold-card {
        border: 2px solid #ffc107;
        border-radius: 15px;
    }

    .card {
        overflow: hidden;
    }

    .form-control {
        height: 48px;
        border-radius: 8px;
    }

    .form-control:focus {
        border-color: #ffc107;
        box-shadow: 0 0 10px rgba(255,193,7,.4);
    }

    .btn-warning,
    .btn-outline-warning {
        height: 48px;
        border-radius: 8px;
    }
</style>

<script>
    function togglePassword(inputId, iconId) {
        const input = document.getElementById(inputId);
        const icon = document.getElementById(iconId);

        if (input.type === "password") {
            input.type = "text";
            icon.classList.remove("bi-eye");
            icon.classList.add("bi-eye-slash");
        } else {
            input.type = "password";
            icon.classList.remove("bi-eye-slash");
            icon.classList.add("bi-eye");
        }
    }
</script>
